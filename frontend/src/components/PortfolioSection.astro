---
/**
 * Shared framed section for the landing page. It keeps spacing and hierarchy
 * consistent while allowing each portfolio block to supply its own design.
 */
type Props = {
	id: string;
	title: string;
	eyebrow?: string;
	description?: string;
	class?: string;
};

const { id, title, eyebrow, description, class: className = '' } = Astro.props;
---

<section id={id} class:list={['grid min-w-0 grid-cols-1 gap-8 py-12 md:gap-12 md:py-16 lg:gap-16 lg:py-18', className]}>
	<div class="grid gap-4">
		{eyebrow && <p class="text-eyebrow">{eyebrow}</p>}
		<h2 class="lora text-display-md uppercase text-foreground max-w-full lg:max-w-1/2">{title}</h2>
		{description && <p class="text-lg leading-relaxed text-muted-strong">{description}</p>}
	</div>
	<div class="py-4 w-full"><slot /></div>
</section>
