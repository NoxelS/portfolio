---
/**
 * Shared framed section for the landing page. It keeps spacing and hierarchy
 * consistent while allowing each portfolio block to supply its own design.
 */
type Props = {
	id: string;
	title: string;
	eyebrow?: string;
	description?: string;
	class?: string;
};

const { id, title, eyebrow, description, class: className = '' } = Astro.props;
---

<section id={id} class:list={['grid gap-8 px-4 py-12 md:gap-12 md:px-8 md:py-16 lg:gap-16 lg:py-24', className]}>
	<div class="grid max-w-2xl gap-4">
		{eyebrow && <p class="text-eyebrow">{eyebrow}</p>}
		<h2 class="lora text-display-md uppercase text-foreground">{title}</h2>
		{description && <p class="text-lg leading-relaxed text-muted-strong">{description}</p>}
	</div>
	<div class="min-w-0"><slot /></div>
</section>
