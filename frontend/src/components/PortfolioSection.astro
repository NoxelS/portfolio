---
/**
 * Shared framed section for the landing page. It keeps spacing and hierarchy
 * consistent while allowing each portfolio block to supply its own design.
 */
type Props = {
	id: string;
	title: string;
	description?: string;
	class?: string;
	noPadding?: boolean;
};

const { id, title, description, class: className = '', noPadding } = Astro.props;

const sectionGaps = noPadding ? '' : 'md:gap-12 lg:gap-16 gap-8';
const slotPadding = noPadding ? '' : 'py-4';

---

<section id={id} data-motion-reveal data-motion-section class:list={['motion-reveal grid min-w-0 grid-cols-1 py-8 md:py-16 lg:py-18', sectionGaps, className]}>
	<div class="grid gap-4">
		<h2 class="lora text-display-md uppercase text-foreground max-w-full lg:max-w-1/2">{title}</h2>
		{description && <p class="text-lg leading-relaxed text-muted-strong lg:max-w-2/3">{description}</p>}
	</div>
	<div class={`w-full ${slotPadding}`}><slot /></div>
</section>
