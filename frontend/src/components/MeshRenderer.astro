---
/**
 * MeshRenderer — client-side OGL WebGL halftone mesh with Canvas 2D fallback.
 *
 * Initialises the animation on the canvas once its frame becomes visible.
 * Uses a plain `<script>` tag so Astro/Vite bundles it as a client module.
 *
 * @component
 */

const {
    canvasId,
    frameId,
    interactionId = frameId
} = Astro.props as {
    canvasId: string;
    frameId: string;
    interactionId?: string;
};
---

<div data-mesh-instance data-frame-id={frameId} data-interaction-id={interactionId} class="absolute inset-0">
    <canvas id={canvasId} class="absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
</div>

<script>
    document.querySelectorAll<HTMLElement>('[data-mesh-instance]:not([data-mesh-bound])').forEach(instance => {
        const canvas = instance.querySelector('canvas') as HTMLCanvasElement | null;
        const frame = instance.dataset.frameId ? document.getElementById(instance.dataset.frameId) : null;
        const interaction = instance.dataset.interactionId ? document.getElementById(instance.dataset.interactionId) : null;

        if (!frame || !interaction || !canvas) return;

        instance.dataset.meshBound = 'true';
        let initialised = false;
        let startScheduled = false;
        let startupTimer: number | null = null;
        let idleCallbackId: number | null = null;
        let frameVisible = false;
        let lcpReady = false;

        const clearStartupScheduling = () => {
            if (startupTimer !== null) {
                window.clearTimeout(startupTimer);
                startupTimer = null;
            }

            if (idleCallbackId !== null && 'cancelIdleCallback' in window) {
                window.cancelIdleCallback(idleCallbackId);
                idleCallbackId = null;
            }
        };

        const start = async () => {
            if (initialised || startScheduled) return;
            startScheduled = true;
            clearStartupScheduling();
            initialised = true;
            const { init } = await import('../scripts/landing-hero');
            init(interaction, frame, canvas);
        };

        const scheduleDuringIdle = () => {
            if (!frameVisible || !lcpReady || initialised || idleCallbackId !== null) return;

            if ('requestIdleCallback' in window) {
                idleCallbackId = window.requestIdleCallback(() => {
                    idleCallbackId = null;
                    void start();
                }, { timeout: 800 });
            } else {
                startupTimer = window.setTimeout(() => {
                    startupTimer = null;
                    void start();
                }, 0);
            }
        };

        // Give the initial LCP candidate and its paint a chance to complete
        // before loading OGL, building the point grid, and starting the RAF.
        if (PerformanceObserver.supportedEntryTypes?.includes('largest-contentful-paint')) {
            const lcpObserver = new PerformanceObserver(() => {
                lcpObserver.disconnect();
                lcpReady = true;
                scheduleDuringIdle();
            });
            lcpObserver.observe({ type: 'largest-contentful-paint', buffered: true });
        } else {
            window.requestAnimationFrame(() => {
                lcpReady = true;
                scheduleDuringIdle();
            });
        }

        // Never leave the decorative animation waiting indefinitely if an LCP
        // entry is unavailable or the browser remains continuously busy.
        startupTimer = window.setTimeout(() => {
            startupTimer = null;
            if (frameVisible) {
                void start();
            }
        }, 800);

        // User intent is a stronger signal than idle scheduling. The listener
        // is one-shot and only schedules the existing asynchronous startup.
        const startOnIntent = () => {
            void start();
        };
        frame.addEventListener('pointerenter', startOnIntent, { once: true, passive: true });
        frame.addEventListener('pointerdown', startOnIntent, { once: true, passive: true });

        const observer = new IntersectionObserver(
            ([entry]) => {
                frameVisible = entry.isIntersecting;
                if (frameVisible) scheduleDuringIdle();
            },
            { threshold: 0 }
        );
        observer.observe(frame);
    });
</script>
