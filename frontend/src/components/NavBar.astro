---

const links = [
  { href: '#who-i-am', label: 'LINK 1' },
  { href: '#my-work', label: 'LINK 2' },
  { href: '#my-background', label: 'LINK 3' },
  { href: '#my-tech-stack', label: 'LINK 4' },
];

---

<nav class="fixed inset-x-0 top-0 z-50">
  <div class="flex h-14 items-center justify-between px-3 sm:px-4 lg:px-6">
    <p class="text-eyebrow font-medium tracking-wide text-muted-strong">
      Noel Schwabenland
    </p>
    <div class="flex items-center gap-6">
      {links.map((link) => (
        <a href={link.href} class="nav-link text-lg font-semibold">
          {link.label}
        </a>
      ))}
      <span class="nav-link text-lg font-semibold bg-accent p-1 text-white">
        <span class="h-2 w-2"></span>
        <span>AVAILABILITY</span>
      </span>
      <span class="nav-link text-lg font-semibold bg-accent p-1 text-white">
        <span class="h-2 w-2"></span>
        <span>CONTACT</span>
      </span>
    </div>
  </div>
</nav>