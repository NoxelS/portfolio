---
/**
 * A searchable, text-only overview of the tools used across the portfolio.
 */
import { Icon } from 'astro-icon/components';
import type { Copy } from '../i18n';

const { copy } = Astro.props as { copy: Copy };

type Technology = {
	name: string;
	href: string;
	productionUse: boolean;
};

type StackGroup = {
	name: string;
	accent: string;
	technologies: Technology[];
};

const productionUseClass = 'border-foreground bg-canvas text-foreground';
const exploratoryUseClass = 'border-foreground bg-[repeating-linear-gradient(135deg,transparent_0,transparent_5px,rgba(0,0,0,0.14)_5px,rgba(0,0,0,0.14)_6px)] text-foreground';

const stackGroups: StackGroup[] = [
	{
		name: copy.stack.groups[0],
		accent: 'bg-black',
		technologies: [
			{ name: 'Angular', href: 'https://angular.dev/', productionUse: true },
			{ name: 'Vue.js', href: 'https://vuejs.org/', productionUse: true },
			{ name: 'HTML', href: 'https://developer.mozilla.org/docs/Web/HTML', productionUse: true },
			{ name: 'CSS', href: 'https://developer.mozilla.org/docs/Web/CSS', productionUse: true },
			{ name: 'SCSS', href: 'https://sass-lang.com/', productionUse: true },
			{ name: 'JavaScript', href: 'https://developer.mozilla.org/docs/Web/JavaScript', productionUse: true },
			{ name: 'TypeScript', href: 'https://www.typescriptlang.org/', productionUse: true },
			{ name: 'Tailwind CSS', href: 'https://tailwindcss.com/', productionUse: true },
			{ name: 'React', href: 'https://react.dev/', productionUse: true },
			{ name: 'Astro', href: 'https://astro.build/', productionUse: true },
			{ name: 'Next.js', href: 'https://nextjs.org/', productionUse: false },
			{ name: 'Svelte', href: 'https://svelte.dev/', productionUse: false },
			{ name: 'Nuxt', href: 'https://nuxt.com/', productionUse: false },
		],
	},
	{
		name: copy.stack.groups[1],
		accent: 'bg-black',
		technologies: [
			{ name: 'Python', href: 'https://www.python.org/', productionUse: true },
			{ name: 'FastAPI', href: 'https://fastapi.tiangolo.com/', productionUse: true },
			{ name: 'C++', href: 'https://isocpp.org/', productionUse: false },
			{ name: 'Java', href: 'https://dev.java/', productionUse: false },
			{ name: 'Node.js', href: 'https://nodejs.org/', productionUse: true },
			{ name: 'Deno', href: 'https://deno.com/', productionUse: false },
			{ name: 'Next.js', href: 'https://nextjs.org/', productionUse: false },
			{ name: 'GraphQL', href: 'https://graphql.org/', productionUse: false },
		],
	},
	{
		name: copy.stack.groups[2],
		accent: 'bg-black',
		technologies: [
			{ name: 'PostgreSQL', href: 'https://www.postgresql.org/', productionUse: true },
			{ name: 'MySQL', href: 'https://www.mysql.com/', productionUse: true },
			{ name: 'MongoDB', href: 'https://www.mongodb.com/', productionUse: false },
			{ name: 'Firebase', href: 'https://firebase.google.com/', productionUse: false },
			{ name: 'Redis', href: 'https://redis.io/', productionUse: true },
			{ name: 'Valkey', href: 'https://valkey.io/', productionUse: true },
			{ name: 'DuckDB', href: 'https://duckdb.org/', productionUse: false },
			{ name: 'Qdrant', href: 'https://qdrant.tech/', productionUse: true },
			{ name: 'pgvector', href: 'https://github.com/pgvector/pgvector', productionUse: false },
			{ name: 'Chroma', href: 'https://www.trychroma.com/', productionUse: false },
			{ name: 'Snowflake', href: 'https://www.snowflake.com/', productionUse: false },
		],
	},
	{
		name: copy.stack.groups[3],
		accent: 'bg-black',
		technologies: [
			{ name: 'Azure', href: 'https://azure.microsoft.com/', productionUse: true },
			{ name: 'Kubernetes', href: 'https://kubernetes.io/', productionUse: true },
			{ name: 'K3s', href: 'https://k3s.io/', productionUse: true },
			{ name: 'Docker', href: 'https://www.docker.com/', productionUse: true },
			{ name: 'Docker Swarm', href: 'https://docs.docker.com/engine/swarm/', productionUse: false },
			{ name: 'Podman', href: 'https://podman.io/', productionUse: true },
			{ name: 'Apache Airflow', href: 'https://airflow.apache.org/', productionUse: false },
			{ name: 'Apache Kafka', href: 'https://kafka.apache.org/', productionUse: false },
			{ name: 'Ansible', href: 'https://www.ansible.com/', productionUse: true },
			{ name: 'Tailscale', href: 'https://tailscale.com/', productionUse: true },
			{ name: 'RabbitMQ', href: 'https://www.rabbitmq.com/', productionUse: true },
			{ name: 'RQ', href: 'https://github.com/rq/rq', productionUse: false },
			{ name: 'GitHub', href: 'https://github.com/', productionUse: true },
			{ name: 'GitLab', href: 'https://about.gitlab.com/', productionUse: true },
			{ name: 'Argo CD', href: 'https://argo-cd.readthedocs.io/', productionUse: true },
			{ name: 'Jenkins', href: 'https://www.jenkins.io/', productionUse: true },
		],
	},
	{
		name: copy.stack.groups[4],
		accent: 'bg-black',
		technologies: [
			{ name: 'vLLM', href: 'https://docs.vllm.ai/', productionUse: true },
			{ name: 'llama.cpp', href: 'https://github.com/ggml-org/llama.cpp', productionUse: true },
			{ name: 'LiteLLM', href: 'https://www.litellm.ai/', productionUse: true },
			{ name: 'Langfuse', href: 'https://langfuse.com/', productionUse: true },
			{ name: 'MLflow', href: 'https://mlflow.org/', productionUse: true },
			{ name: 'Feast', href: 'https://feast.dev/', productionUse: false },
			{ name: 'n8n', href: 'https://n8n.io/', productionUse: false },
		],
	},
	{
		name: copy.stack.groups[5],
		accent: 'bg-black',
		technologies: [
			{ name: 'LangGraph', href: 'https://langchain-ai.github.io/langgraph/', productionUse: true },
			{ name: 'LangChain', href: 'https://www.langchain.com/', productionUse: true },
			{ name: 'NOOA', href: 'https://github.com/NVIDIA-NeMo/labs-OO-Agents', productionUse: false },
			{ name: 'AgentOS', href: 'https://docs.agno.com/agent-os', productionUse: false },
			{ name: 'TensorFlow', href: 'https://www.tensorflow.org/', productionUse: true },
			{ name: 'PyTorch', href: 'https://pytorch.org/', productionUse: false },
			{ name: 'SciPy', href: 'https://scipy.org/', productionUse: true },
			{ name: 'NumPy', href: 'https://numpy.org/', productionUse: true },
			{ name: 'Pandas', href: 'https://pandas.pydata.org/', productionUse: true },
			{ name: 'Polars', href: 'https://pola.rs/', productionUse: true },
			{ name: 'Transformers', href: 'https://huggingface.co/docs/transformers/index', productionUse: false },
		],
	},
];
---

<div class="grid gap-4 mt-8 md:gap-8" data-tech-stack>
	<div class="motion-reveal flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between self-end" data-motion-reveal>
		<div class="flex flex-wrap items-center gap-x-6 gap-y-3 text-base leading-tight text-muted-strong self-end" aria-label="Technology experience legend">
			<span class="flex items-center gap-3"><span class="h-5 w-5 shrink-0 border border-foreground bg-canvas"></span>{copy.stack.production}</span>
			<span class="flex items-center gap-3"><span class="h-5 w-5 shrink-0 border border-foreground bg-[repeating-linear-gradient(135deg,transparent_0,transparent_3px,rgba(0,0,0,0.25)_3px,rgba(0,0,0,0.25)_4px)]"></span>{copy.stack.research}</span>
		</div>
		<label class="group flex min-w-0 items-center gap-3 border border-foreground bg-canvas px-4 py-3 text-foreground transition-colors focus-within:bg-foreground focus-within:text-canvas sm:w-72" for="tech-stack-search">
			<Icon name="iconoir:search" class="h-5 w-5 shrink-0" aria-hidden="true" />
			<span class="sr-only">{copy.stack.search}</span>
			<input id="tech-stack-search" data-tech-stack-search type="search" placeholder={copy.stack.search} autocomplete="off" class="min-w-0 flex-1 bg-transparent text-base text-inherit outline-none placeholder:text-muted-strong group-focus-within:placeholder:text-canvas/65" />
		</label>
	</div>

	<div class="grid gap-2 sm:gap-3" data-tech-stack-groups>
		{stackGroups.map((group, index) => (
			<section
				data-tech-stack-group
				data-group-name={group.name.toLowerCase()}
				class:list={[
					'motion-reveal grid min-w-0 grid-cols-1 border border-foreground bg-canvas md:grid-cols-[17rem_minmax(0,1fr)]',
					index === 0 && 'lg:delay-0',
					index === 1 && 'lg:delay-50',
					index === 2 && 'lg:delay-100',
					index === 3 && 'lg:delay-150',
					index === 4 && 'lg:delay-200',
					index >= 5 && 'lg:delay-250',
				]}
				data-motion-reveal
			>
				<div class="relative flex min-h-14 items-center bg-foreground p-3 text-canvas sm:min-h-24 sm:p-5 md:min-h-full">
					<span class:list={['absolute left-0 top-0 h-1.5 w-20', group.accent]}></span>
					<h3 class="lora text-xl leading-none uppercase sm:text-3xl">{group.name}</h3>
				</div>
				<div class="grid min-w-0 grid-cols-[repeat(auto-fit,minmax(6rem,1fr))] gap-2 bg-black/5 p-2 sm:gap-3 sm:p-3">
					{group.technologies.map((technology) => (
						<a data-tech-stack-item data-technology-name={technology.name.toLowerCase()} data-production-use={technology.productionUse} href={technology.href} target="_blank" rel="noreferrer" class:list={['relative flex h-12 min-w-0 items-center justify-center border p-2 transition-colors duration-200 hover:bg-none hover:bg-foreground hover:text-canvas focus-visible:bg-none focus-visible:bg-foreground focus-visible:text-canvas focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-accent', technology.productionUse ? productionUseClass : exploratoryUseClass]} aria-label={`Open ${technology.name} website in a new tab`} title={`${technology.name} — ${technology.productionUse ? 'production use' : 'research and side projects'}`}>
							<span class="max-w-full break-words text-center text-xs font-semibold leading-tight" aria-hidden="true">{technology.name}</span>
						</a>
					))}
				</div>
			</section>
		))}
	</div>

	<p data-tech-stack-empty class="hidden border border-dashed border-foreground px-5 py-10 text-center text-muted-strong" aria-live="polite">{copy.stack.noMatches}</p>
</div>

<script>
	const techStack = document.querySelector<HTMLElement>('[data-tech-stack]');

	if (techStack) {
		const search = techStack.querySelector<HTMLInputElement>('[data-tech-stack-search]');
		const groups = [...techStack.querySelectorAll<HTMLElement>('[data-tech-stack-group]')];
		const emptyState = techStack.querySelector<HTMLElement>('[data-tech-stack-empty]');

		search?.addEventListener('input', () => {
			const query = search.value.trim().toLowerCase();
			let visibleGroups = 0;

			groups.forEach((group) => {
				const groupMatch = group.dataset.groupName?.includes(query) ?? false;
				let visibleItems = 0;

				group.querySelectorAll<HTMLElement>('[data-tech-stack-item]').forEach((item) => {
					const itemMatch = item.dataset.technologyName?.includes(query) ?? false;
					const visible = !query || groupMatch || itemMatch;
					item.classList.toggle('hidden', !visible);
					if (visible) visibleItems += 1;
				});

				const visible = visibleItems > 0;
				group.classList.toggle('hidden', !visible);
				if (visible) visibleGroups += 1;
			});

			emptyState?.classList.toggle('hidden', visibleGroups > 0);
		});
	}
</script>
