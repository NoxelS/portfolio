			{ name: 'C++', icon: 'mdi:language-cpp', href: 'https://isocpp.org/', productionUse: false },
			{ name: 'Java', icon: 'mdi:language-java', href: 'https://dev.java/', productionUse: false },
			{ name: 'Node.js', icon: 'mdi:nodejs', href: 'https://nodejs.org/', productionUse: true },
			{ name: 'Deno', icon: 'mdi:language-typescript', href: 'https://deno.com/', productionUse: true },
			{ name: 'Next.js', icon: 'mdi:layers-triple', href: 'https://nextjs.org/', productionUse: false },
			{ name: 'GraphQL', icon: 'mdi:graphql', href: 'https://graphql.org/', productionUse: false },
		],
