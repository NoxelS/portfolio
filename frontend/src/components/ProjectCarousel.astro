---
import '@glidejs/glide/dist/css/glide.core.min.css';
import type { Project } from '../data/projects';
import ActionLink from './ActionLink.astro';
import { cloudflareImageUrl } from '../utils/cloudflare-image';

type Props = {
    projects: Project[];
    tags: string[];
};

const { projects, tags } = Astro.props;
---

<div class="grid gap-8" data-project-carousel>
    <div class="flex flex-col-reverse items-end gap-2 pt-4 sm:pt-0">
        <span class="order-last ml-auto text-sm text-primary-text-color uppercase">Filter by</span>
        <div class="flex flex-wrap justify-end gap-2" aria-label="Filter projects by tag" data-project-filters>
            {
                tags.map((tag, index) => (
                    <button
                        class:list={[
                            'motion-reveal focus-ring inline-flex cursor-pointer items-center gap-1.5 border px-3 py-2 text-sm font-medium uppercase tracking-[0.08em] leading-[1.1]',
                            index === 0 && 'lg:delay-0',
                            index === 1 && 'lg:delay-50',
                            index === 2 && 'lg:delay-100',
                            index === 3 && 'lg:delay-150',
                            index === 4 && 'lg:delay-200',
                            index >= 5 && 'lg:delay-250',
                            tag === 'Highlighted'
                                ? 'project-filter-active hover:bg-primary/90 hover:text-canvas'
                                : 'border-primary-text-color bg-transparent text-primary-text-color hover:bg-surface hover:text-primary-text-color',
                        ]}
                        type="button"
                        data-project-filter={tag}
                        data-motion-reveal
                        aria-pressed={tag === 'Highlighted' ? 'true' : 'false'}
                    >
                        <span class:list={{ hidden: tag !== 'Highlighted' }} aria-hidden="true">✓</span>
                        {tag}
                    </button>
                ))
            }
        </div>
    </div>

    <div class="project-carousel glide min-w-0" aria-label="Projects carousel" data-project-glide>
        <div class="relative min-w-0">
            <div class="glide__track overflow-hidden" data-glide-el="track">
                <ul class="glide__slides py-4" data-project-slides>
                {
                    projects.map(project => (
                        <li
                            class="glide__slide flex h-auto"
                            data-project-filters={JSON.stringify(project.filters)}
                        >
																	<article class="relative flex h-auto min-w-0 w-full max-w-full max-h-none flex-col gap-4 overflow-y-visible border-0 bg-canvas p-0 sm:max-h-[56rem] sm:overflow-y-auto sm:border sm:border-primary-text-color sm:p-8" data-project-card>
                                <header class="flex min-w-0 flex-col items-start gap-3">
                                    <div class="relative flex h-14 w-28 shrink-0 items-center justify-start overflow-hidden">
                                        {project.logoSrc && (
                                            project.companyUrl ? (
                                                <a
                                                    class="focus-ring flex h-14 w-28 items-center justify-start"
                                                    href={project.companyUrl}
                                                    target="_blank"
                                                    rel="noreferrer"
                                                    aria-label={`Open ${project.logoAlt ?? project.title} website in a new tab`}
                                                >
                                                    <img class="max-h-full max-w-full object-contain grayscale" src={cloudflareImageUrl(project.logoSrc, { width: 256 })} alt="" loading="lazy" decoding="async" />
                                                </a>
                                            ) : (
                                                <div
                                                    class="flex h-14 w-28 items-center justify-start"
                                                    role="img"
                                                    aria-label={project.logoAlt ?? `${project.title} logo`}
                                                >
                                                    <img class="max-h-full max-w-full object-contain grayscale" src={cloudflareImageUrl(project.logoSrc, { width: 256 })} alt="" loading="lazy" decoding="async" />
                                                </div>
                                            )
                                        )}
                                    </div>
                                    <div class="flex min-w-0 flex-row items-center gap-3">
										<h3 class="lora min-w-0 max-w-full break-words text-2xl leading-tight text-primary-text-color sm:text-3xl">{project.title}</h3>
                                    </div>
                                </header>

								<p class="m-0 p-0 text-lg leading-relaxed text-primary-text-color">{project.summary}</p>

                                <ol class="grid gap-6 md:grid-cols-3 md:gap-0" aria-label={`${project.title} case-study steps`}>
                                    {project.steps.map((step, index) => (
                                        <li class="relative grid grid-cols-[1.75rem_minmax(0,1fr)] gap-3 md:grid-cols-1 md:gap-4 md:pr-6">
                                            {index < project.steps.length - 1 && (
                                                <>
                                                    <div
																	class="absolute left-[0.8125rem] top-7 h-[calc(100%-0.5rem)] border-l border-dotted border-primary-text-color md:hidden"
                                                        aria-hidden="true"
                                                    />
                                                    <div
																	class="absolute left-7 right-0 top-[0.8125rem] hidden border-t border-dotted border-primary-text-color md:block"
                                                        aria-hidden="true"
                                                    />
                                                </>
                                            )}
							<span class="relative z-10 flex h-7 w-7 items-center justify-center border border-primary-text-color bg-canvas text-sm font-semibold text-primary-text-color">
                                                {index + 1}
                                            </span>
                                            <div class="grid gap-2">
												<h4 class="lora text-lg leading-tight text-primary-text-color">{step.label}</h4>
												<p class="text-[0.9375rem] leading-relaxed text-primary-text-color sm:text-base">{step.content}</p>
                                            </div>
                                        </li>
                                    ))}
                                </ol>

                                <div class="mt-auto flex flex-wrap gap-2 self-end" aria-label={`${project.title} tags`}>
                                    {project.tags.map(tag => (
										<span class="border border-primary-text-color px-2.5 py-1 text-sm text-primary-text-color">{tag}</span>
                                    ))}
                                </div>
                            </article>
                        </li>
                    ))
                }
                </ul>
            </div>
        </div>
		<p class="hidden py-3 pl-4 text-copy-md text-primary-text-color" data-project-empty role="status">
            No projects match the selected tags. Select one or more tags to see projects.
        </p>

        <div class="mt-4 flex flex-wrap items-center justify-between gap-4 pt-5" data-glide-el="controls">
            <button
                class="focus-ring cursor-pointer border border-primary-text-color px-4 py-3.5 text-sm font-medium uppercase tracking-[0.08em] leading-[1.1] text-primary-text-color transition-[background-color,color,border-color,opacity] duration-150 ease-[var(--ease-standard)] hover:bg-surface hover:text-primary-text-color disabled:cursor-not-allowed disabled:opacity-40"
                type="button"
                data-glide-dir="<"
                data-project-control
                aria-label="Show previous project"
            >
                Previous
            </button>
			<p class="text-copy-sm min-w-0 text-center text-primary-text-color uppercase" aria-live="polite" data-project-count>{projects.length} projects shown</p>
            <button
                class="focus-ring cursor-pointer border border-primary-text-color px-4 py-3.5 text-sm font-medium uppercase tracking-[0.08em] leading-[1.1] text-primary-text-color transition-[background-color,color,border-color,opacity] duration-150 ease-[var(--ease-standard)] hover:bg-surface hover:text-primary-text-color disabled:cursor-not-allowed disabled:opacity-40"
                type="button"
                data-glide-dir=">"
                data-project-control
                aria-label="Show next project"
            >
                Next
            </button>
        </div>
    </div>

    <!-- <div class="flex flex-row gap-4">
        <ActionLink href="#tech-stack" variant="primary" icon="iconoir:arrow-down" class="w-fit"> See my tech stack </ActionLink>
        <ActionLink href="#contact" variant="secondary" icon="iconoir:arrow-down" class="w-fit"> Contact me about a project </ActionLink>
    </div> -->
</div>

<script>
    import Glide from '@glidejs/glide';

    document.querySelectorAll<HTMLElement>('[data-project-carousel]').forEach(carousel => {
        if (carousel.dataset.projectCarouselMounted === 'true') return;

        const glideRoot = carousel.querySelector<HTMLElement>('[data-project-glide]');
        const slides = carousel.querySelector<HTMLUListElement>('[data-project-slides]');
        const filters = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-project-filter]'));
        const controls = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-project-control]'));
        const count = carousel.querySelector<HTMLElement>('[data-project-count]');
        const emptyState = carousel.querySelector<HTMLElement>('[data-project-empty]');
        if (!glideRoot || !slides || !count || !emptyState) return;

        const allSlides = Array.from(slides.children) as HTMLLIElement[];
        const selectedTags = new Set(['Highlighted']);
        let glide: Glide | undefined;

        const syncCardHeight = () => {
            const cards = Array.from(slides.querySelectorAll<HTMLElement>('[data-project-card]'));
            slides.style.removeProperty('height');
            if (cards.length === 0) return;

            cards.forEach(card => card.style.removeProperty('height'));
            const activeSlide = slides.querySelector<HTMLElement>('.glide__slide--active') ?? slides.querySelector<HTMLElement>('.glide__slide');
            const activeCard = activeSlide?.querySelector<HTMLElement>('[data-project-card]');
            if (!activeCard) return;

            slides.style.setProperty('height', `${Math.ceil(activeCard.getBoundingClientRect().height)}px`);
        };

        const updateFilterButtons = () => {
            filters.forEach(filter => {
                const tag = filter.dataset.projectFilter ?? '';
                const isSelected = selectedTags.has(tag);
                filter.setAttribute('aria-pressed', String(isSelected));
                filter.classList.toggle('project-filter-active', isSelected);
                filter.classList.toggle('border-transparent', isSelected);
                filter.classList.toggle('bg-primary', isSelected);
                filter.classList.toggle('text-canvas', isSelected);
                filter.classList.toggle('border-primary-text-color', !isSelected);
                filter.classList.toggle('bg-transparent', !isSelected);
                filter.classList.toggle('text-primary-text-color', !isSelected);
                filter.classList.toggle('hover:bg-primary/90', isSelected);
                filter.classList.toggle('hover:text-canvas', isSelected);
                filter.classList.toggle('hover:bg-surface', !isSelected);
                filter.classList.toggle('hover:text-primary-text-color', !isSelected);
                filter.querySelector('span')!.classList.toggle('hidden', !isSelected);
            });
        };

        const mountGlide = (projectCount: number) => {
            if (projectCount > 1) {
                glide = new Glide(glideRoot, {
                    type: 'carousel',
                    perView: 1.25,
                    focusAt: 'center',
                    gap: 28,
                    breakpoints: { 1024: { perView: 1 }, 640: { perView: 1 } }
                }).mount();
                glide.on('run.after', syncCardHeight);
            }
            controls.forEach(control => {
                control.disabled = projectCount < 2;
            });
        };

        const updateProjects = () => {
            glide?.destroy();
            glide = undefined;

            const matchingSlides = allSlides.filter(slide => {
                const projectFilters = JSON.parse(slide.dataset.projectFilters ?? '[]') as string[];
                return projectFilters.some(filter => selectedTags.has(filter));
            });
            slides.replaceChildren(...matchingSlides);
            count.textContent = `${matchingSlides.length} ${matchingSlides.length === 1 ? 'project' : 'projects'} shown`;
            emptyState.classList.toggle('hidden', matchingSlides.length !== 0);
            mountGlide(matchingSlides.length);
            requestAnimationFrame(syncCardHeight);
        };

        filters.forEach(filter => {
            filter.addEventListener('click', () => {
                const tag = filter.dataset.projectFilter;
                if (!tag) return;
                if (selectedTags.has(tag)) selectedTags.delete(tag);
                else selectedTags.add(tag);
                updateFilterButtons();
                updateProjects();
            });
        });

        updateProjects();
        window.addEventListener('resize', syncCardHeight);
        carousel.dataset.projectCarouselMounted = 'true';
    });
</script>
