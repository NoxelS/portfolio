---
/**
 * ContactOptions — compact contact choices for the portfolio contact section.
 *
 * Values can be passed explicitly or configured with PUBLIC_CONTACT_EMAIL,
 * PUBLIC_CONTACT_PHONE, PUBLIC_CONTACT_PHONE_SECONDARY, and PUBLIC_KOALENDAR_URL.
 */
import ActionLink from './ActionLink.astro';
import { getPublicEnv } from '../lib/public-env';

type Props = {
    email?: string;
    phone?: string;
    phoneSecondary?: string;
    koalendarUrl?: string;
};

const { email, phone, phoneSecondary, koalendarUrl } = Astro.props;
const contactEmail = email ?? getPublicEnv('PUBLIC_CONTACT_EMAIL');
const contactPhone = phone ?? getPublicEnv('PUBLIC_CONTACT_PHONE');
const contactPhoneSecondary = phoneSecondary ?? getPublicEnv('PUBLIC_CONTACT_PHONE_SECONDARY');
const scheduleUrl = koalendarUrl ?? getPublicEnv('PUBLIC_KOALENDAR_URL', 'https://koalendar.com/e/noel-pascal-schwabenland');
const phoneHref = contactPhone.replace(/[^+\d]/g, '');
const phoneSecondaryHref = contactPhoneSecondary.replace(/[^+\d]/g, '');
---

<div class="grid w-full min-w-0 grid-cols-1 gap-10 md:grid-cols-3 md:gap-8 lg:gap-12">
    <article class="motion-reveal grid min-w-0 grid-rows-[1fr_auto] gap-5 lg:delay-0" data-motion-reveal>
        <div class="grid gap-3">
            <h3 class="lora text-2xl leading-none uppercase text-foreground sm:text-3xl">Give me a direct call</h3>
            <p class="text-base leading-relaxed text-muted-strong">I'm always available during European business hours (8–18 CET), so feel free to give me a direct call.</p>
        </div>

        <div class="grid grid-cols-2 gap-3 self-end">
            {contactPhone && (
                <ActionLink href={`tel:${phoneHref}`} variant="secondary" icon="iconoir:phone" class="h-14 w-full min-w-0 justify-between text-left">
                    🇩🇪 {contactPhone}
                </ActionLink>
            )}
            {contactPhoneSecondary && (
                <ActionLink href={`tel:${phoneSecondaryHref}`} variant="secondary" icon="iconoir:phone" class="h-14 w-full min-w-0 justify-between text-left">
                    🇮🇹 {contactPhoneSecondary}
                </ActionLink>
            )}
            {!contactPhone && !contactPhoneSecondary && <p class="text-caption"></p>}
        </div>
    </article>

    <article class="motion-reveal grid min-w-0 grid-rows-[1fr_auto] gap-5 lg:delay-150" data-motion-reveal>
        <div class="grid gap-3">
            <h3 class="lora text-2xl leading-none uppercase text-foreground sm:text-3xl">Send an E-Mail</h3>
            <p class="text-base leading-relaxed text-muted-strong">Please include your contact details and the reason for your inquiry. With more information, I can provide a more accurate and helpful response.</p>
        </div>

        {contactEmail ? (
            <ActionLink href={`mailto:${contactEmail}`} variant="secondary" icon="iconoir:mail" class="h-14 w-full min-w-0 justify-between text-left">
                {contactEmail}
            </ActionLink>
        ) : (
            <p class="text-caption">An email address will appear here once configured.</p>
        )}
    </article>

    <article class="motion-reveal grid min-w-0 grid-rows-[1fr_auto] gap-5 lg:delay-300" data-motion-reveal>
        <div class="grid gap-3">
            <h3 class="lora text-2xl leading-none uppercase text-foreground sm:text-3xl">schedule a call or meeting</h3>
            <p class="text-base leading-relaxed text-muted-strong">Choose a convenient time for a quick chat directly in my calendar.
				I will either call you per phone or we can meet via video conference.
			</p>
        </div>

        <ActionLink href={scheduleUrl} target="_blank" rel="noreferrer" variant="secondary" icon="iconoir:calendar" class="h-14 w-full min-w-0 justify-between text-left">
            Schedule a call
        </ActionLink>
    </article>
</div>
