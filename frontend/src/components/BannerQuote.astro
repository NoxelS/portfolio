---
/**
 * BannerQuote — editorial callout between page sections.
 *
 * Renders a personal principle between content blocks on the portfolio
 * landing page.
 *
 * @component
 * @prop {string} quote - The guiding principle.
 * @prop {string} subquote - Supporting perspective.
 */

const { quote, subquote } = Astro.props as {
    quote: string;
    subquote: string;
};

---

<!-- Personal principle between page sections -->
<aside class="-mx-4 w-[calc(100%+2rem)] min-w-0 bg-gray-950 px-4 py-10 md:-mx-8 md:w-[calc(100%+4rem)] md:px-8 md:py-14" aria-label="Portfolio principle">
	<div class="grid min-w-0 gap-8 lg:grid-cols-[minmax(0,3fr)_minmax(14rem,1fr)] lg:gap-12">
        <blockquote>
            <p class="lora max-w-4xl text-3xl leading-[1.08] text-white sm:text-4xl lg:text-5xl">{quote}</p>
        </blockquote>
        <div class="lg:max-w-sm lg:justify-self-end lg:self-end">
            <p class="text-base leading-relaxed text-white">{subquote}</p>
        </div>
    </div>
    <slot />
</aside>
