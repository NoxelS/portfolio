---
/**
 * BannerQuote — editorial callout between page sections.
 *
 * Renders a styled headline + paragraph pair used as visual breathing room
 * between content blocks on the portfolio landing page.
 *
 * @component
 * @prop {string} quote - The headline text.
 * @prop {string} subquote - Supporting description displayed beneath the headline.
 */

const { quote, subquote } = Astro.props;

---

<!-- Editorial callout block between page sections -->
<aside class="grid gap-6 bg-gray-800/3 px-4 py-8 md:px-8 md:py-16 lg:grid-cols-5 lg:items-end lg:gap-16" aria-label="Portfolio statement">
    <h2 class="lora text-display-md uppercase text-foreground lg:col-span-3">{quote}</h2>
    <p class="max-w-2xl text-lg leading-relaxed text-muted-strong lg:col-span-2">{subquote}</p>
</aside>
