---
/**
 * BannerQuote — editorial callout between page sections.
 *
 * Renders a styled headline + paragraph pair used as visual breathing room
 * between content blocks on the portfolio landing page.
 *
 * @component
 * @prop {string} quote - The headline text.
 * @prop {string} subquote - Supporting description displayed beneath the headline.
 */

const { quote, subquote } = Astro.props;

---

<!-- Editorial callout block between page sections -->
<aside class="grid gap-6 border border-accent/20 px-[var(--site-container-inline)] py-[clamp(2rem,5vw,4rem)] lg:grid-cols-[minmax(0,1fr)_minmax(18rem,0.78fr)] lg:items-end lg:gap-16" aria-label="Portfolio statement">
    <h2 class="lora text-[clamp(2.25rem,5vw,4.25rem)] leading-[0.98] uppercase text-foreground">{quote}</h2>
    <p class="max-w-[42rem] text-lg leading-relaxed text-muted-strong">{subquote}</p>
</aside>
