---
/**
 * BannerQuote — editorial callout between page sections.
 *
 * Renders a personal principle between content blocks on the portfolio
 * landing page.
 *
 * @component
 * @prop {string} quote - The guiding principle.
 * @prop {string} subquote - Supporting perspective.
 */
import MeshRenderer from './MeshRenderer.astro';

const { id, quote, subquote, label } = Astro.props as {
    id?: string;
    quote: string;
    subquote: string;
    label: string;
};

const hasSubquote = subquote.trim().length > 0;
const meshKey = quote.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const meshFrameId = `banner-mesh-frame-${meshKey}`;
const meshCanvasId = `banner-mesh-canvas-${meshKey}`;

---

<!-- Personal principle between page sections -->
<aside id={id} class="relative -mx-4 w-[calc(100%+2rem)] min-w-0 overflow-hidden bg-mesh-background px-4 py-10 md:-mx-8 md:w-[calc(100%+4rem)] md:px-8 md:py-14" aria-label={label}>
    <div id={meshFrameId} class="absolute inset-0 overflow-hidden opacity-75" aria-hidden="true">
        <MeshRenderer canvasId={meshCanvasId} frameId={meshFrameId} client:load />
    </div>
    <div class:list={[
        'relative z-10 grid min-w-0 gap-8',
        hasSubquote && 'lg:grid-cols-[minmax(0,3fr)_minmax(14rem,1fr)] lg:gap-12'
    ]}>
        <blockquote>
            <p class:list={[
                'lora text-3xl leading-[1.08] text-canvas sm:text-4xl lg:text-5xl',
                hasSubquote && 'max-w-4xl'
            ]}>{quote}</p>
        </blockquote>
        {hasSubquote && (
            <div class="lg:max-w-sm lg:justify-self-end lg:self-end">
                <p class="text-base leading-relaxed text-canvas">{subquote}</p>
            </div>
        )}
    </div>
	<div class="relative z-10">
	    <slot />
	</div>
</aside>
