---
/**
 * Reusable portfolio action. Use it for navigation and external links so
 * controls keep the same compact, editorial treatment while designs evolve.
 */
import { Icon } from 'astro-icon/components';

type Props = {
	href: string;
	variant?: 'primary' | 'secondary' | 'inverse';
	size?: 'sm' | 'md';
	icon?: string;
	class?: string;
	target?: string;
	rel?: string;
};

const {
	href,
	variant = 'primary',
	size = 'md',
	icon,
	class: className = '',
	target,
	rel,
} = Astro.props;

const variants = {
	primary: 'border-transparent bg-soft-periwinkle-800 text-white hover:bg-soft-periwinkle-900 hover:text-white',
	secondary: 'border-soft-periwinkle-800 text-soft-periwinkle-800 hover:bg-surface hover:text-soft-periwinkle-900',
	inverse: 'border-white/80 text-white hover:bg-white hover:text-black',
};

const sizes = {
	sm: 'px-3.5 py-[0.7rem]',
	md: 'px-[1.1rem] py-[0.9rem]',
};
---

<a
	href={href}
	target={target}
	rel={rel}
	class:list={[
		'inline-flex items-center justify-center gap-3.5 border text-sm font-medium uppercase tracking-[0.08em] leading-[1.1] no-underline transition-[background-color,color,border-color] duration-150 ease-[var(--ease-standard)]',
		variants[variant],
		sizes[size],
		'focus-ring',
		className,
	]}
>
	<span><slot /></span>
	{icon && <Icon name={icon} class="h-5 w-5" aria-hidden="true" />}
</a>
