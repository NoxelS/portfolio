---
/**
 * LandingPage — composition layer for the portfolio landing page.
 *
 * Owns the full-viewport section shell and the identity overlay (name, title,
 * tagline, CTA). Delegates the animated halftone mesh to LandingHero, which
 * owns its own markup, styles, and inline canvas script — see LandingHero.astro.
 */
import LandingHero from './LandingHero.astro';
import ActionLink from './ActionLink.astro';
---

<!-- Full-viewport section shell -->
<section id="landing-page" class="relative flex min-h-[100svh] w-full flex-col gap-6">
    <!-- Renders the animated halftone mesh. -->
    <LandingHero />
    <div class="relative mt-[50svh] flex w-full flex-col gap-6 p-8 py-12 md:gap-8 md:py-16">
        <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
            <div class="flex flex-col gap-2">
                <p class="text-eyebrow">Freelance Full Stack AI Engineer</p>
                <h1 class="lora text-display-md uppercase text-foreground max-w-full">Noël Pascal Schwabenland</h1>
            </div>
            <div class="size-44 shrink-0 self-start overflow-hidden rounded-full border-4 border-white/80 md:size-48 md:self-auto lg:absolute lg:top-16 lg:right-8">
                <img src="/IMG_0445.jpeg" alt="Noel Pascal Schwabenland" class="size-full object-fit" />
            </div>
        </div>

        <p class="text-lg leading-relaxed text-muted-strong lg:max-w-2/3">
            EU-based full-stack AI Engineer helping industrial and technology companies turn internal knowledge and complex workflows into production-ready RAG, voice, and AI agent solutions. 
            I build with governed data and European regulatory requirements in mind.
        </p>

        <p class="text-caption">I'm currently available 20h/week</p>
        
        <div class="flex flex-row flex-wrap gap-4 self-start">
            <ActionLink href="#work-banner" icon="iconoir:arrow-down">Explore my work</ActionLink>
            <ActionLink href="#contact-banner" variant="secondary">Give me a call</ActionLink>
        </div>
    </div>
</section>
