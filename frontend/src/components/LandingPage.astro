---
/**
 * LandingPage — composition layer for the portfolio landing page.
 *
 * Owns the full-viewport section shell and the identity overlay (name, title,
 * tagline, CTA). Delegates the animated halftone mesh to LandingHero, which
 * owns its own markup, styles, and inline canvas script — see LandingHero.astro.
 */
import LandingHero from './LandingHero.astro';
import ActionLink from './ActionLink.astro';
---

<!-- Full-viewport section shell -->
<section id="landing-page" class="relative flex min-h-[100svh] w-full flex-col gap-6">
    <!-- Renders the animated halftone mesh. -->
    <LandingHero />
    <div class="relative mt-[50svh] flex w-full flex-col gap-6 p-8 py-12 md:gap-8 md:py-16">
        <div class="flex flex-col gap-2">
            <p class="text-eyebrow text-soft-periwinkle-800">Freelance Full Stack AI Engineer</p>
            <h1 class="lora text-display-lg tracking-[-0.02em] uppercase text-balance">Noel Pascal Schwabenland</h1>
        </div>

        <p class="max-w-3/4 text-copy-lg text-muted-strong">
            <!-- AI Engineer with real-world multi-disciplinary expertise in full-stack software development, ML Ops, and Data Science.  -->
            I help companies analyze potential opportunities and drive innovation through strategic technology solutions with 
            a focus on generative AI, RAG, agentic systems, speech processing, and inference pipelines.
        </p>

        <p class="text-caption">I'm currently available 20h/week</p>
        
        <div class="flex flex-row flex-wrap gap-4 self-start">
            <ActionLink href="#my-projects" icon="iconoir:arrow-down">Explore my work</ActionLink>
            <ActionLink href="#contact" variant="secondary">Give me a call</ActionLink>
        </div>
    </div>
</section>
