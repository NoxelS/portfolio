---
/**
 * LandingPage — composition layer for the portfolio landing page.
 *
 * Owns the full-viewport section shell and the identity overlay (name, title,
 * tagline, CTA). Delegates the animated halftone mesh to LandingHero, which
 * owns its own markup, styles, and inline canvas script — see LandingHero.astro.
 */
import { imageAssets } from '../utils/image-assets';
import LandingHero from './LandingHero.astro';
import ActionLink from './ActionLink.astro';
import { cloudflareImageSrcSet, cloudflareImageUrl } from '../utils/cloudflare-image';
import type { Copy, Locale } from '../i18n';

const { copy, locale } = Astro.props as { copy: Copy; locale: Locale };
// Hidden portrait layouts select this inline source instead of downloading a second photo.
const hiddenPortrait = 'data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22/%3E';
---

<!-- Full-viewport section shell -->
<section id="landing-page" class="relative flex min-h-[100svh] w-full flex-col">
    <!-- Renders the animated halftone mesh. -->
    <LandingHero copy={copy.hero} labels={copy.ui} locale={locale} />
    <div class="relative z-20 grid w-full min-w-0 shrink-0 gap-6 p-6 py-8 sm:gap-8 sm:p-8 sm:py-12 md:py-16 lg:grid-cols-[minmax(0,1fr)_auto] lg:gap-12">
        <div class="flex min-w-0 flex-col gap-4 sm:gap-6 md:gap-8">
            <div class="flex flex-col gap-2">
                <div class="flex flex-col-reverse items-start gap-4 sm:flex-row sm:items-stretch">
                    <h1 class="lora min-w-0 flex-1 text-[clamp(1.75rem,8vw,2.25rem)] leading-[0.98] uppercase text-foreground sm:text-display-md">
                        <span class="block lg:inline">Noël Pascal</span><span class="hidden lg:inline"> </span><span class="block whitespace-nowrap lg:inline">Schwabenland</span>
                    </h1>
                    <div class="size-[clamp(3.5rem,18vw,4.5rem)] shrink-0 overflow-hidden rounded-full border-4 border-white/80 lg:hidden">
                        <picture class="block size-full">
                            <source media="(width >= 64rem)" srcset={hiddenPortrait} />
                            <img
                                src={cloudflareImageUrl(imageAssets.portrait, { width: 192 })}
                                srcset={cloudflareImageSrcSet(imageAssets.portrait, [64, 128, 192])}
                                sizes="clamp(48px, calc(18vw - 8px), 64px)"
                                alt=""
                                class="block size-full min-h-0 min-w-0 object-cover"
                                width="384"
                                height="384"
                                decoding="async"
                            />
                        </picture>
                    </div>
                </div>
            </div>

            <p class="text-lg leading-relaxed text-muted-strong lg:max-w-2/3">
                <span class="sm:hidden">{copy.hero.summaryCompact}</span>
                <span class="hidden sm:inline">{copy.hero.summary}</span>
            </p>

            <!-- <p class="motion-reveal translate-y-10 text-caption opacity-0" data-motion-reveal data-motion-immediate>I'm currently available 20h/week</p> -->

            <div class="flex flex-row flex-wrap gap-4 self-start">
                <ActionLink href="#work" icon="iconoir:arrow-down" class="!gap-2 !px-3 !py-2.5 sm:!gap-3.5 sm:!px-4 sm:!py-3.5">{copy.hero.exploreWork}</ActionLink>
                <ActionLink href="#contact" variant="secondary" class="!px-3 !py-2.5 sm:!px-4 sm:!py-3.5">{copy.hero.contact}</ActionLink>
            </div>
        </div>

        <div class="hidden aspect-square w-[clamp(12rem,20vw,18rem)] overflow-hidden rounded-full border-4 border-white/80 lg:block">
            <picture class="block size-full">
                <source media="(width < 64rem)" srcset={hiddenPortrait} />
                <img
                    src={cloudflareImageUrl(imageAssets.portrait, { width: 500 })}
                    srcset={cloudflareImageSrcSet(imageAssets.portrait, [192, 288, 384, 500])}
                    sizes="(min-width: 1440px) 280px, calc(20vw - 8px)"
                    alt={copy.hero.portraitAlt}
                    class="block size-full object-cover"
                    width="384"
                    height="384"
                    decoding="async"
                />
            </picture>
        </div>
    </div>
</section>
