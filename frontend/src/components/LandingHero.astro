---
/**
 * LandingHero — animated liquid halftone mesh rendered via OGL (WebGL2).
 *
 * Owns a full-viewport `<div id="mesh-frame">` containing layered radial
 * gradients, dot-noise grain, and a canvas that paints thousands of deformed
 * circular halftone points whose motion is driven by layered sine waves
 * and mouse-positioned vortex fields.
 *
 * The WebGL rendering is delegated to a bundled client module
 * (`landing-hero.ts`) which loads OGL dynamically and falls back to Canvas 2D
 * on any failure.
 *
 * @component
 */
import { Icon } from 'astro-icon/components';
import MeshRenderer from './MeshRenderer.astro';
---

<div
    id="mesh-frame"
    class="relative min-h-0 w-full flex-1 overflow-hidden bg-gray-950"
    aria-label="Abstract liquid halftone mesh"
    role="img"
>
    <div class="absolute top-0 left-0 z-10 flex w-full justify-between px-6 py-8 sm:p-8">
        <div class="text-white">
            <div class="px-4 py-2 text-base hidden"><span class="underline">EN</span> / DE / IT</div>
        </div>
        <div class="text-white">
            <a
                href="#contact-banner"
                class="bg-primary/10 inline-flex text-white cursor-pointer border border-white px-4 py-2 text-base no-underline hover:text-primary hover:bg-white hover:border-white"
            >
                Give me a call
            </a>
        </div>
    </div>
    <MeshRenderer canvasId="hero-mesh-canvas" frameId="mesh-frame" interactionId="landing-page" client:load />
    <div class="mesh-shadow mesh-shadow-a"></div>
    <div class="mesh-shadow mesh-shadow-b"></div>
    <div class="mesh-grain"></div>
    <div class="absolute bottom-0 left-0 z-10 flex w-full items-end justify-between px-6 py-8 sm:p-8">
        <div class="flex flex-col items-start gap-4">
            <div class="lora text-display-sm text-white opacity-85 md:leading-none">
                I build with scalability, <br> maintainability and performance in mind.
                <span class="group relative ml-1 inline-flex align-middle" data-performance-toggle>
                    <button
                        type="button"
                        class="inline-flex h-[0.8em] w-[0.8em] items-center justify-center rounded-full pb-1 text-white/70 transition hover:bg-white/15 hover:text-white focus-visible:bg-white/15 focus-visible:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                        aria-label="View site performance details"
                        aria-describedby="site-performance-tooltip"
                        aria-expanded="false"
                    >
                        <Icon name="mdi:information-outline" class="h-[0.8em] w-[0.8em] text-white" aria-hidden="true" />
                    </button>
                    <span
                        id="site-performance-tooltip"
                        role="tooltip"
                        class="pointer-events-none invisible absolute right-0 bottom-full z-20 mb-3 w-72 rounded-sm bg-gray-950/95 p-4 font-sans text-sm leading-relaxed text-white opacity-0 shadow-xl ring-1 ring-white/15 transition group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 data-[open=true]:visible data-[open=true]:opacity-100"
                    >
                        Server delivery: <span class="font-semibold" data-site-load-time>…</span> ms. LCP:
                        <span class="font-semibold" data-site-lcp>…</span> ms. Yes, I even over-optimized my
                        portfolio website.
                    </span>
                </span>
            </div>
        </div>
        <div class="hidden flex-col gap-2 sm:flex">
            <div class="text-white uppercase text-sm">My socials</div>
            <div class="flex flex-row gap-4">
                <a
                    href="https://github.com/NoxelS"
                    aria-label="GitHub profile"
                    target="_blank"
                    rel="noreferrer"
                    class="flex w-8 h-8 items-center justify-center bg-white text-black transition hover:bg-white/85"
                >
                    <Icon name="mdi:github" class="h-5 w-5" aria-hidden="true" />
                </a>
                <a
                    href="https://www.linkedin.com/in/noel-schwabenland/"
                    aria-label="LinkedIn profile"
                    target="_blank"
                    rel="noreferrer"
                    class="flex w-8 h-8 items-center justify-center bg-white text-black transition hover:bg-white/85"
                >
                    <Icon name="mdi:linkedin" class="h-5 w-5" aria-hidden="true" />
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    const updateSiteLoadTime = () => {
        const output = document.querySelector<HTMLElement>('[data-site-load-time]');
        const navigation = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;

        if (!output || !navigation) {
            return;
        }

        const cloudflareTimings = new Map(navigation.serverTiming.map((timing) => [timing.name, timing]));
        const edgeDuration = cloudflareTimings.get('cfEdge')?.duration ?? 0;
        const originDuration = cloudflareTimings.get('cfOrigin')?.duration ?? 0;
        const serverDuration = edgeDuration + originDuration;
        const browserDuration = navigation.loadEventEnd;
        const duration = serverDuration > 0 ? serverDuration : browserDuration;

        if (duration > 0) {
            output.textContent = String(Math.round(duration));
        }
    };

    const updateLargestContentfulPaint = (value: number) => {
        const output = document.querySelector<HTMLElement>('[data-site-lcp]');

        if (!output || value <= 0) {
            return;
        }

        output.textContent = String(Math.round(value));
    };

    if (PerformanceObserver.supportedEntryTypes?.includes('largest-contentful-paint')) {
        const observer = new PerformanceObserver((list) => {
            const entries = list.getEntries();
            const latest = entries[entries.length - 1];

            if (latest) {
                updateLargestContentfulPaint(latest.startTime);
            }
        });

        observer.observe({ type: 'largest-contentful-paint', buffered: true });
    }

    const performanceToggle = document.querySelector<HTMLElement>('[data-performance-toggle]');
    const performanceButton = performanceToggle?.querySelector<HTMLButtonElement>('button');

    if (performanceToggle && performanceButton) {
        const closePerformanceTooltip = () => {
            performanceToggle.removeAttribute('data-open');
            performanceButton.setAttribute('aria-expanded', 'false');
        };

        performanceButton.addEventListener('click', () => {
            const isOpen = performanceToggle.getAttribute('data-open') === 'true';

            if (isOpen) {
                closePerformanceTooltip();
            } else {
                performanceToggle.setAttribute('data-open', 'true');
                performanceButton.setAttribute('aria-expanded', 'true');
            }
        });

        document.addEventListener('click', (event) => {
            if (!performanceToggle.contains(event.target as Node)) {
                closePerformanceTooltip();
            }
        });

        performanceButton.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
                closePerformanceTooltip();
                performanceButton.blur();
            }
        });
    }

    if (document.readyState === 'complete') {
        updateSiteLoadTime();
    } else {
        window.addEventListener('load', updateSiteLoadTime, { once: true });
    }
</script>


<style>
    .mesh-shadow,
    .mesh-grain {
        pointer-events: none;
        position: absolute;
    }

    .mesh-shadow {
        inset: -18%;
        opacity: 0.62;
    }

    .mesh-shadow-a {
        background: radial-gradient(ellipse at 36% 56%, rgb(3 7 19 / 0.86) 0%, transparent 46%);
    }

    .mesh-shadow-b {
        background: radial-gradient(ellipse at 72% 54%, rgb(5 8 23 / 0.82) 0%, transparent 42%);
    }

    .mesh-grain {
        background-image: radial-gradient(circle at center, rgb(255 255 255 / 0.18) 0 0.0625rem, transparent 0.075rem);
        background-size: 0.45rem 0.45rem;
        inset: 0;
        mix-blend-mode: soft-light;
        opacity: 0.22;
    }
</style>
