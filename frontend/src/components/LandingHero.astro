---
/**
 * LandingHero — animated liquid halftone mesh rendered via OGL (WebGL2).
 *
 * Owns a full-viewport `<div id="mesh-frame">` containing layered radial
 * gradients, dot-noise grain, and a canvas that paints thousands of deformed
 * circular halftone points whose motion is driven by layered sine waves
 * and mouse-positioned vortex fields.
 *
 * The WebGL rendering is delegated to a bundled client module
 * (`landing-hero.ts`) which loads OGL dynamically and falls back to Canvas 2D
 * on any failure.
 *
 * @component
 */
import { Icon } from 'astro-icon/components';
import MeshRenderer from './MeshRenderer.astro';
---

<div
    id="mesh-frame"
    class="relative min-h-0 w-full flex-1 overflow-hidden bg-gray-950"
    aria-label="Abstract liquid halftone mesh"
    role="img"
>
    <div class="absolute top-0 left-0 z-10 flex w-full justify-between p-8">
        <div class="text-white">
            <div class="px-4 py-2 text-base"><span class="underline">EN</span> / DE / IT</div>
        </div>
        <div class="text-white">
            <a
                href="#contact-banner"
                class="bg-primary/10 inline-flex text-white cursor-pointer border border-white px-4 py-2 text-base no-underline hover:text-primary hover:bg-white hover:border-white"
            >
                Give me a call
            </a>
        </div>
    </div>
    <MeshRenderer canvasId="hero-mesh-canvas" frameId="mesh-frame" interactionId="landing-page" client:load />
    <div class="mesh-shadow mesh-shadow-a"></div>
    <div class="mesh-shadow mesh-shadow-b"></div>
    <div class="mesh-grain"></div>
    <div class="absolute bottom-0 left-0 z-10 flex w-full justify-between items-end p-8">
        <div class="lora text-display-sm text-white opacity-85 md:leading-none">
            I build with scalability, <br> maintainability and performance in mind.
        </div>
        <div class="flex flex-col gap-2">
            <div class="text-white uppercase text-sm">My socials</div>
            <div class="flex flex-row gap-4">
                <a
                    href="https://github.com/NoxelS"
                    aria-label="GitHub profile"
                    target="_blank"
                    rel="noreferrer"
                    class="flex w-8 h-8 items-center justify-center bg-white text-black transition hover:bg-white/85"
                >
                    <Icon name="mdi:github" class="h-5 w-5" aria-hidden="true" />
                </a>
                <a
                    href="https://www.linkedin.com/in/noel-schwabenland/"
                    aria-label="LinkedIn profile"
                    target="_blank"
                    rel="noreferrer"
                    class="flex w-8 h-8 items-center justify-center bg-white text-black transition hover:bg-white/85"
                >
                    <Icon name="mdi:linkedin" class="h-5 w-5" aria-hidden="true" />
                </a>
            </div>
        </div>
    </div>
</div>


<style>
    .mesh-shadow,
    .mesh-grain {
        pointer-events: none;
        position: absolute;
    }

    .mesh-shadow {
        inset: -18%;
        opacity: 0.62;
    }

    .mesh-shadow-a {
        background: radial-gradient(ellipse at 36% 56%, rgb(3 7 19 / 0.86) 0%, transparent 46%);
    }

    .mesh-shadow-b {
        background: radial-gradient(ellipse at 72% 54%, rgb(5 8 23 / 0.82) 0%, transparent 42%);
    }

    .mesh-grain {
        background-image: radial-gradient(circle at center, rgb(255 255 255 / 0.18) 0 0.0625rem, transparent 0.075rem);
        background-size: 0.45rem 0.45rem;
        inset: 0;
        mix-blend-mode: soft-light;
        opacity: 0.22;
    }
</style>
