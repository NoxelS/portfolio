---
/** Three service areas for applied AI projects. */
import type { Copy } from '../i18n';

const { copy } = Astro.props as { copy: Copy };
---

<div class="grid w-full min-w-0 grid-cols-1 gap-8 md:gap-10 lg:grid-cols-3 lg:gap-x-16">
    {copy.work.chapters.map((chapter, index) => (
        <article
            class:list={[
                'motion-reveal grid content-start gap-4',
                index === 1 && 'lg:delay-150',
                index === 2 && 'lg:delay-300',
            ]}
            data-motion-reveal
        >
            <h3 class="lora text-2xl leading-tight uppercase text-foreground sm:text-3xl">{chapter.title}</h3>
            <p class="text-base leading-relaxed text-muted-strong">{chapter.body}</p>
        </article>
    ))}
</div>
