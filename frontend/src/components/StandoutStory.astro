---
/** Background shared by every locale; the section owns its navigation CTAs. */
import type { Copy } from '../i18n';

const { copy } = Astro.props as { copy: Copy['work'] };
---

<div class="grid w-full min-w-0 grid-cols-1 gap-8 md:gap-10 lg:grid-cols-[repeat(3,minmax(0,1fr))] lg:grid-rows-[auto_1fr] lg:gap-x-24 lg:gap-y-4">
    {copy.chapters.map((chapter, index) => (
        <article
            class:list={[
                'motion-reveal row-span-2 grid h-full min-w-0 w-full grid-cols-1 gap-4 lg:grid-rows-subgrid',
                index === 0 && 'lg:delay-0',
                index === 1 && 'lg:delay-150',
                index === 2 && 'lg:delay-300',
            ]}
            data-motion-reveal
        >
            <h3 class="lora min-w-0 break-words hyphens-auto text-2xl leading-none uppercase text-foreground sm:text-3xl">{chapter.title}</h3>
            <p class="min-w-0 text-base leading-relaxed text-muted-strong">{chapter.body}</p>
        </article>
    ))}
</div>
