---
const currentYear = new Date().getFullYear();
---

<footer class="-mx-4 w-[calc(100%+2rem)] min-w-0 bg-gray-950 px-4 py-10 text-white md:-mx-8 md:w-[calc(100%+4rem)] md:px-8 md:py-12">
	<div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between md:gap-12">
		<div class="flex flex-col gap-2">
			<p class="lora text-2xl">Noël Pascal Schwabenland</p>
			<p class="text-sm text-white/65">© {currentYear} Noël Pascal Schwabenland. All rights reserved.</p>
		</div>

		<nav aria-label="Legal and other links">
			<ul class="flex flex-wrap gap-x-6 gap-y-3 text-sm">
				<li><a href="/privacy" class="text-white/75 hover:text-white hover:decoration-white">Privacy</a></li>
				<li><a href="/imprint" class="text-white/75 hover:text-white hover:decoration-white">Imprint</a></li>
				<li><a href="/index.md" class="text-white/75 hover:text-white hover:decoration-white">For agents</a></li>
			</ul>
		</nav>
	</div>
</footer>
