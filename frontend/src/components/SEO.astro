---
import { defaultSeo } from '../data/site';
import { copy, locales, type Locale } from '../i18n';

interface Props {
	title?: string;
	description?: string;
	canonicalPath?: string;
	image?: string;
	imageAlt?: string;
	imageType?: string;
	imageWidth?: number;
	imageHeight?: number;
	type?: 'website' | 'profile' | 'article';
	noindex?: boolean;
	locale: Locale;
}

const {
	title = defaultSeo.title,
	description = defaultSeo.description,
	canonicalPath = Astro.url.pathname,
	image = defaultSeo.image,
	imageAlt = defaultSeo.imageAlt,
	imageType = 'image/jpeg',
	imageWidth = 2060,
	imageHeight = 2060,
	type = 'website',
	noindex = false,
	locale,
} = Astro.props;

const siteUrl = Astro.site?.toString() ?? defaultSeo.site;
const localizedCopy = copy[locale];
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const absoluteImage = image ? new URL(image, siteUrl).toString() : undefined;
const isStaging = import.meta.env.PUBLIC_DEPLOYMENT_ENV === 'staging';
const pageId = `${canonicalUrl}#webpage`;
const personId = `${siteUrl}#person`;
const websiteId = `${siteUrl}#website`;
const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': websiteId,
			name: defaultSeo.siteName,
			url: siteUrl,
			inLanguage: locale,
			publisher: { '@id': personId },
		},
		{
			'@type': 'ProfilePage',
			'@id': pageId,
			url: canonicalUrl,
			name: title,
			description,
			inLanguage: locale,
			isPartOf: { '@id': websiteId },
			mainEntity: { '@id': personId },
		},
		{
			'@type': 'Person',
			'@id': personId,
			name: defaultSeo.authorName,
			url: siteUrl,
			image: absoluteImage,
			description: defaultSeo.description,
			jobTitle: 'Freelance full-stack AI engineer',
			worksFor: { '@type': 'Organization', name: defaultSeo.authorName },
			areaServed: { '@type': 'Place', name: 'European Union' },
			knowsAbout: ['Artificial intelligence', 'RAG', 'AI agents', 'Voice AI', 'Software engineering'],
			sameAs: ['https://github.com/NoxelS', 'https://www.linkedin.com/in/noel-schwabenland/'],
		},
	],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
{description && <meta name="description" content={description} />}
{(noindex || isStaging) && <meta name="robots" content="noindex,nofollow" />}
<link rel="canonical" href={canonicalUrl} />
{locales.map((alternateLocale) => <link rel="alternate" hreflang={alternateLocale} href={new URL(`/${alternateLocale}/`, siteUrl)} />)}
<link rel="alternate" hreflang="x-default" href={new URL('/en/', siteUrl)} />
<link rel="describedby" href="/llms.txt" />

<meta property="og:site_name" content={defaultSeo.siteName} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonicalUrl} />
{absoluteImage && <meta property="og:image" content={absoluteImage} />}
{absoluteImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
{absoluteImage && <meta property="og:image:type" content={imageType} />}
{absoluteImage && <meta property="og:image:width" content={imageWidth.toString()} />}
{absoluteImage && <meta property="og:image:height" content={imageHeight.toString()} />}

<meta name="twitter:card" content={absoluteImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
{absoluteImage && <meta name="twitter:image" content={absoluteImage} />}
{absoluteImage && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
