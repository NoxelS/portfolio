---
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import SEO from '../components/SEO.astro';
import { getOpenPanelConfig } from '../data/analytics';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	canonicalPath?: string;
	noindex?: boolean;
}

const { title, description, canonicalPath, noindex } = Astro.props;
const openPanelConfig = getOpenPanelConfig();
const runtimeConfig = {
	PUBLIC_BUILD_VERSION: process.env.PUBLIC_BUILD_VERSION ?? '',
	PUBLIC_COMMIT_SHA: process.env.PUBLIC_COMMIT_SHA ?? '',
	PUBLIC_BUILT_AT: process.env.PUBLIC_BUILT_AT ?? '',
};
---

<!doctype html>
<html lang="en">
	<head>
		<SEO title={title} description={description} canonicalPath={canonicalPath} noindex={noindex} />
	</head>
	<body>
		<main class="min-h-screen overflow-x-hidden px-3 py-6 sm:px-4 lg:px-6">
			<slot />
		</main>
		<script define:vars={{ runtimeConfig }}>
			window.__PORTFOLIO_RUNTIME__ = runtimeConfig;
		</script>
		{openPanelConfig && <AnalyticsConsent />}
		{
			openPanelConfig && (
				<script define:vars={{ openPanelConfig }}>
					window.__PORTFOLIO_ANALYTICS__ = openPanelConfig;
				</script>
			)
		}
		{
			openPanelConfig && (
				<script>
					import '../scripts/analytics-loader';
				</script>
			)
		}
	</body>
</html>
