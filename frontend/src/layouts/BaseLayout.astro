---
import { Font } from 'astro:assets';
import Footer from '../components/Footer.astro';
import CookieSettings from '../components/CookieSettings.astro';
import NavBar from '../components/NavBar.astro';
import SEO from '../components/SEO.astro';
import { copy, type Locale } from '../i18n';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	canonicalPath?: string;
	image?: string;
	imageAlt?: string;
	imageType?: string;
	imageWidth?: number;
	imageHeight?: number;
	noindex?: boolean;
	locale: Locale;
}

const { title, description, canonicalPath, image, imageAlt, imageType, imageWidth, imageHeight, noindex, locale } = Astro.props;
const cloudflareImageResizingEnabled = import.meta.env.PUBLIC_CLOUDFLARE_IMAGE_RESIZING === 'true';
const imageClientHintOrigin = Astro.site?.host ?? Astro.url.host;
const runtimeConfig = {
	PUBLIC_BUILD_VERSION: process.env.PUBLIC_BUILD_VERSION ?? '',
	PUBLIC_COMMIT_SHA: process.env.PUBLIC_COMMIT_SHA ?? '',
	PUBLIC_BUILT_AT: process.env.PUBLIC_BUILT_AT ?? '',
};
---

<!doctype html>
<html lang={locale} style="scroll-behavior: smooth">
	<head>
		{cloudflareImageResizingEnabled && imageClientHintOrigin && (
			<meta http-equiv="Delegate-CH" content={`sec-ch-dpr ${imageClientHintOrigin}; sec-ch-viewport-width ${imageClientHintOrigin}`} />
		)}
		<SEO
			title={title}
			description={description}
			canonicalPath={canonicalPath}
			image={image}
			imageAlt={imageAlt}
			imageType={imageType}
			imageWidth={imageWidth}
			imageHeight={imageHeight}
			noindex={noindex}
			locale={locale}
		/>
		<!-- Preload above-the-fold fonts; optional display keeps late arrivals from moving content. -->
		<Font cssVariable="--font-portfolio-lora" preload={[{ style: 'normal' }]} />
		<Font cssVariable="--font-portfolio-source-sans" preload={[{ style: 'normal' }]} />
		<link rel="apple-touch-icon" sizes="180x180" href="/favicon_io/apple-touch-icon.png">
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon_io/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon_io/favicon-16x16.png">
		<link rel="manifest" href="/favicon_io/site.webmanifest">
	</head>
	<body>
		<div class="pointer-events-none fixed inset-x-0 top-0 z-50 h-1 origin-left scale-x-0 bg-accent" data-scroll-progress aria-hidden="true"></div>
		<NavBar />
		<main class="min-h-screen w-screen max-w-[100vw]">
			<slot />
		</main>
		<Footer copy={copy[locale]} locale={locale} />
		<CookieSettings locale={locale} />
		<script define:vars={{ runtimeConfig }}>
			window.__PORTFOLIO_RUNTIME__ = runtimeConfig;
		</script>
		</body>
		<script>
			import '../scripts/motion';
		</script>
</html>
