---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Qwen';
const description = 'Qwen';
---

<BaseLayout
	title={title}
	description={description}
	canonicalPath="/qwen"
	image="/qwen.png"
	imageAlt="Qwen"
	imageType="image/png"
	imageWidth={1644}
	imageHeight={206}
>
	<section class="mx-auto flex min-h-[70vh] w-full max-w-5xl items-center justify-center px-4 py-12 md:px-8">
		<img src="/qwen.png" alt="Qwen" width="1644" height="206" class="h-auto w-full" />
	</section>
</BaseLayout>
