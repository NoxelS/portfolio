---
import BaseLayout from '../layouts/BaseLayout.astro';

const colors = [
	['Canvas', 'bg-canvas', 'Base page background'],
	['Surface', 'bg-surface', 'Default card surface'],
	['Raised', 'bg-surface-raised', 'Elevated surface'],
	['Border', 'bg-border', 'Default divider/border'],
	['Accent', 'bg-accent', 'Primary action color'],
	['Success', 'bg-success', 'Positive state'],
	['Warning', 'bg-warning', 'Caution state'],
	['Danger', 'bg-danger', 'Error state'],
];

const spacing = [1, 2, 3, 4, 6, 8, 12, 16, 24];
---

<BaseLayout title="Style System" canonicalPath="/style-system" noindex>
	<section class="section-space pt-8">
		<div class="page-container stack-xl">
			<header class="grid max-w-3xl gap-3">
				<p class="text-eyebrow text-accent">Style System</p>
				<h1 class="heading-section sm:text-5xl">Portfolio frontend foundation</h1>
				<p class="text-lead">A working showcase for CSS-first design tokens, Tailwind utilities, and the few composition patterns that will replace one-off page styling over time.</p>
			</header>

			<section class="card card-lg">
				<div class="grid gap-8">
					<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
						<div>
							<h2 class="heading-section">Utility Contract</h2>
							<p class="mt-2 text-caption">Atomistic styling lives in Tailwind v4 CSS utilities, not Astro components.</p>
						</div>
						<span class="badge badge-accent">CSS-first</span>
					</div>
					<pre class="overflow-x-auto border border-border bg-canvas p-4 text-sm text-muted-strong"><code>{`<button class="btn btn-primary btn-primary-md"><span class="btn-label">Send</span></button>`}</code></pre>
				</div>
			</section>

			<div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
				<section class="card card-lg">
					<div class="grid gap-8">
						<div>
							<h2 class="heading-section">Color Tokens</h2>
							<p class="mt-2 text-caption">Semantic tokens keep page code independent from a specific palette.</p>
						</div>
						<div class="grid gap-3 sm:grid-cols-2">
							{colors.map(([label, swatch, description]) => (
								<div class="flex items-center gap-3 border border-border bg-canvas p-3">
									<div class:list={['size-10 border border-border-strong', swatch]}></div>
									<div>
										<p class="text-sm font-semibold text-foreground">{label}</p>
										<p class="text-xs text-muted">{description}</p>
									</div>
								</div>
							))}
						</div>
					</div>
				</section>

				<section class="card card-lg">
					<div class="grid gap-8">
						<div>
							<h2 class="heading-section">Spacing Scale</h2>
							<p class="mt-2 text-caption">Spacing uses Tailwind's 4px base and prefers `gap` for sibling rhythm.</p>
						</div>
						<div class="grid gap-3">
							{spacing.map((step) => (
								<div class="grid grid-cols-[3rem_minmax(0,1fr)] items-center gap-4 text-sm">
									<span class="font-mono text-muted">{step}</span>
									<div class="h-3 bg-accent" style={`width: calc(var(--spacing) * ${step});`}></div>
								</div>
							))}
						</div>
					</div>
				</section>
			</div>

			<section class="card card-lg">
				<div class="grid gap-8">
					<div>
						<h2 class="heading-section">Typography</h2>
						<p class="mt-2 text-caption">The first pass keeps the type scale close to Tailwind defaults while exposing semantic content styles.</p>
					</div>
					<div class="grid gap-6 lg:grid-cols-2">
						<div class="grid gap-3">
							<p class="text-eyebrow text-accent">Eyebrow Label</p>
							<p class="heading-display">Display Heading</p>
							<p class="heading-section">Section Heading</p>
							<p class="text-lead">Body copy should be readable first and decorative second. Line-height is intentionally generous for portfolio explanations.</p>
							<p class="text-caption">Caption copy for quiet supporting information.</p>
							<p class="text-meta">Meta Label</p>
						</div>
						<div class="rich-text">
							<h3>Rich Text Content</h3>
							<p>Markdown and generated text should share the same contrast, rhythm, and <a href="/style-system">link treatment</a> as authored content.</p>
							<ul>
								<li>Use semantic HTML for structure.</li>
								<li>Keep arbitrary values rare.</li>
								<li>Prefer utilities for atomic styling.</li>
							</ul>
							<p>Inline <code>code</code> also follows the token system.</p>
						</div>
					</div>
				</div>
			</section>

			<section class="card card-lg">
				<div class="grid gap-8">
					<div>
						<h2 class="heading-section">Tailwind Utilities</h2>
						<p class="text-lead">CSS-first utilities provide reusable design-system behavior directly in Tailwind class names.</p>
					</div>
					<div class="grid gap-8 lg:grid-cols-2">
						<div class="grid gap-4">
							<h3 class="heading-card">Links</h3>
							<div class="flex flex-wrap gap-4">
								<a class="link" href="/style-system">Base link</a>
								<a class="link link-primary-500" href="/style-system">Primary 500</a>
								<a class="link link-primary-700" href="/style-system">Primary 700</a>
								<a class="link link-thistle-500" href="/style-system">Thistle 500</a>
								<a class="link link-petal-600" href="/style-system">Petal 600</a>
								<a class="link link-periwinkle-600" href="/style-system">Periwinkle 600</a>
								<a class="link link-muted" href="/style-system">Muted</a>
								<a class="link-plain" href="/style-system">Plain hover link</a>
							</div>
						</div>
						<div class="grid gap-4">
							<h3 class="heading-card">Surfaces And Interaction</h3>
							<div class="grid gap-3 sm:grid-cols-2">
								<div class="surface p-4">
									<p class="font-semibold text-foreground">surface</p>
									<p class="text-caption">Uses surface background, border, and shadow.</p>
								</div>
								<div class="surface-raised p-4">
									<p class="font-semibold text-foreground">surface-raised</p>
									<p class="text-caption">A stronger surface utility.</p>
								</div>
							</div>
							<button class="btn btn-secondary btn-md focus-ring hard-press" type="button">Focus ring and hard press</button>
						</div>
					</div>
				</div>
			</section>

			<section class="card card-lg">
				<div class="grid gap-8">
					<div>
						<h2 class="heading-section">Atoms</h2>
						<p class="mt-2 text-caption">Buttons, badges, and fields are plain HTML with Tailwind utility classes.</p>
					</div>
					<div class="grid gap-8 lg:grid-cols-2">
						<div class="grid gap-5">
							<div class="flex flex-wrap gap-3">
								<button class="btn btn-primary btn-primary-md focus-ring" type="button"><span class="btn-label">Primary Button</span></button>
								<button class="btn btn-secondary btn-md focus-ring" type="button">Secondary Button</button>
								<button class="btn btn-ghost btn-md focus-ring" type="button">Ghost Button</button>
							</div>
							<div class="flex flex-wrap gap-2">
								<span class="badge badge-neutral">Neutral</span>
								<span class="badge badge-accent">Accent</span>
								<span class="badge badge-success">Success</span>
								<span class="badge badge-warning">Warning</span>
								<span class="badge badge-danger">Danger</span>
							</div>
						</div>
						<div class="grid gap-5">
							<label class="field">
								<span class="field-label">Input</span>
								<input class="field-control focus-ring" placeholder="Ask about projects, skills, or experience" />
							</label>
							<label class="field">
								<span class="field-label">Textarea</span>
								<textarea class="field-control field-textarea focus-ring" placeholder="Longer message"></textarea>
							</label>
						</div>
					</div>
				</div>
			</section>

			<section class="card card-lg">
				<div class="stack-lg">
					<div>
						<h2 class="heading-section">Layout Primitives</h2>
						<p class="mt-2 text-caption">Use these utilities for structure before reaching for page-specific grid classes.</p>
					</div>
					<div class="two-column">
						<div class="stack">
							<h3 class="heading-card">Stack And Cluster</h3>
							<div class="stack-sm border border-border bg-white p-4">
								<span class="badge badge-neutral">stack-sm</span>
								<span class="badge badge-accent">consistent vertical rhythm</span>
								<span class="badge badge-success">gap based</span>
							</div>
							<div class="cluster border border-border bg-white p-4">
								<span class="badge badge-neutral">cluster</span>
								<span class="badge badge-accent">wraps</span>
								<span class="badge badge-warning">inline rhythm</span>
							</div>
						</div>
						<div class="stack">
							<h3 class="heading-card">Auto Grid</h3>
							<div class="auto-grid">
								<div class="stat"><p class="stat-value">3</p><p class="stat-label">Cards</p></div>
								<div class="stat"><p class="stat-value">18rem</p><p class="stat-label">Minimum width</p></div>
								<div class="stat"><p class="stat-value">1fr</p><p class="stat-label">Flexible columns</p></div>
							</div>
						</div>
					</div>
					<hr class="divider" />
					<div class="cluster-between">
						<p class="text-caption">`cluster-between` handles responsive horizontal distribution.</p>
						<a class="btn btn-secondary btn-md focus-ring" href="/">Back home</a>
					</div>
				</div>
			</section>

			<section class="card card-lg">
				<div class="stack-lg">
					<div>
						<h2 class="heading-section">Navigation</h2>
						<p class="mt-2 text-caption">Plain links, navigation links, and tab-like navigation states.</p>
					</div>
					<nav class="cluster" aria-label="Example navigation">
						<a class="nav-link" aria-current="page" href="/style-system">Overview</a>
						<a class="nav-link" href="/style-system">Projects</a>
						<a class="nav-link" href="/style-system">Experience</a>
						<a class="nav-link" href="/style-system">Contact</a>
					</nav>
					<nav class="cluster" aria-label="Example tabs">
						<a class="nav-tab" aria-current="page" href="/style-system">Active Tab</a>
						<a class="nav-tab" href="/style-system">Inactive Tab</a>
						<a class="nav-tab" href="/style-system">Another Tab</a>
					</nav>
				</div>
			</section>

			<section class="card card-lg">
				<div class="stack-lg">
					<div>
						<h2 class="heading-section">Feedback States</h2>
						<p class="mt-2 text-caption">Alerts and destructive actions use semantic status tokens.</p>
					</div>
					<div class="auto-grid">
						<div class="alert alert-info"><p class="font-semibold text-foreground">Info</p><p class="text-caption">Use for neutral guidance or additional context.</p></div>
						<div class="alert alert-success"><p class="font-semibold text-foreground">Success</p><p class="text-caption">Use for completed or positive outcomes.</p></div>
						<div class="alert alert-warning"><p class="font-semibold text-foreground">Warning</p><p class="text-caption">Use for caution, limits, or non-blocking issues.</p></div>
						<div class="alert alert-danger"><p class="font-semibold text-foreground">Danger</p><p class="text-caption">Use for errors or destructive consequences.</p></div>
					</div>
					<div class="cluster">
						<button class="btn btn-danger btn-md focus-ring" type="button">Danger Button</button>
						<span class="badge badge-danger">Danger Badge</span>
					</div>
				</div>
			</section>

			<section class="card card-lg">
				<div class="stack-lg">
					<div>
						<h2 class="heading-section">Structured Content</h2>
						<p class="mt-2 text-caption">Lists, timelines, tables, and code blocks for project detail pages.</p>
					</div>
					<div class="two-column">
						<div class="stack">
							<h3 class="heading-card">Divided List</h3>
							<ul class="list-divided border border-border bg-white p-4">
								<li><p class="font-semibold text-foreground">Portfolio RAG</p><p class="text-caption">FastAPI backend, local model, retrieval pipeline.</p></li>
								<li><p class="font-semibold text-foreground">Analytics</p><p class="text-caption">Privacy-conscious event tracking and build info.</p></li>
								<li><p class="font-semibold text-foreground">Design System</p><p class="text-caption">CSS-first Tailwind utilities for reusable primitives.</p></li>
							</ul>
						</div>
						<div class="stack">
							<h3 class="heading-card">Timeline</h3>
							<ol class="timeline bg-white p-4">
								<li class="timeline-item"><p class="font-semibold text-foreground">Research</p><p class="text-caption">Collect spacing, color, and component constraints.</p></li>
								<li class="timeline-item"><p class="font-semibold text-foreground">Systemize</p><p class="text-caption">Move atom styles into CSS utilities.</p></li>
								<li class="timeline-item"><p class="font-semibold text-foreground">Compose</p><p class="text-caption">Use components only for meaningful composition.</p></li>
							</ol>
						</div>
					</div>
					<div class="table-wrap">
						<table class="data-table">
							<thead><tr><th>Utility</th><th>Purpose</th><th>Use Case</th></tr></thead>
							<tbody>
								<tr><td><code class="code-inline">card</code></td><td>Surface block</td><td>Sections, panels, project cards</td></tr>
								<tr><td><code class="code-inline">cluster</code></td><td>Wrapping inline layout</td><td>Actions, tags, nav</td></tr>
								<tr><td><code class="code-inline">rich-text</code></td><td>Generated prose</td><td>Markdown/RAG responses</td></tr>
							</tbody>
						</table>
					</div>
					<pre class="code-block"><code>{`<section class="card card-lg stack-lg">
  <h2 class="heading-section">Project</h2>
  <p class="text-lead">Readable summary text.</p>
</section>`}</code></pre>
					<p class="text-caption">Keyboard affordance example: <kbd class="kbd">⌘</kbd> <kbd class="kbd">K</kbd></p>
				</div>
			</section>

			<section class="card card-lg">
				<div class="stack-lg">
					<div>
						<h2 class="heading-section">Loading States</h2>
						<p class="mt-2 text-caption">Skeletons use the same surface tokens as cards and panels.</p>
					</div>
					<div class="grid gap-3 border border-border bg-white p-4">
						<div class="skeleton h-5 w-2/3"></div>
						<div class="skeleton h-4 w-full"></div>
						<div class="skeleton h-4 w-5/6"></div>
					</div>
				</div>
			</section>
		</div>
	</section>
</BaseLayout>
