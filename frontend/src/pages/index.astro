---
/**
 * Portfolio landing page — top-level route.
 *
 * Composes the full-page layout: hero (LandingPage), alternating banner
 * quotes, and section blocks (Projects, TechStack, Contact, Footer).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingPage from '../components/LandingPage.astro';
import ProjectCarousel from '../components/ProjectCarousel.astro';
import BannerQuote from '../components/BannerQuote.astro';
import PortfolioSection from '../components/PortfolioSection.astro';
import StandoutStory from '../components/StandoutStory.astro';
import PartnerLogoCarousel from '../components/PartnerLogoCarousel.astro';
import TechStack from '../components/TechStack.astro';
import ContactOptions from '../components/ContactOptions.astro';
import Footer from '../components/Footer.astro';
import ActionLink from '../components/ActionLink.astro';
import { Icon } from 'astro-icon/components';
import { getAllTags, getSortedProjects } from '../data/projects';
import { copy, type Locale } from '../i18n';

export const prerender = false;

const { locale = 'en' } = Astro.props as { locale?: Locale };
const localizedCopy = copy[locale];
const projects = getSortedProjects();
const projectTags = getAllTags();
---

<BaseLayout locale={locale} title={localizedCopy.seo.title} description={localizedCopy.seo.description} canonicalPath={`/${locale}/`} imageAlt={localizedCopy.seo.imageAlt}>
    <LandingPage copy={localizedCopy} locale={locale} />

    <div class="grid w-full min-w-0 grid-cols-1 gap-8 px-4 md:px-8">
        <BannerQuote
            id="work"
            quote={localizedCopy.work.quote}
            subquote={localizedCopy.work.subquote}
        />

        <!-- Who I Am -->
        <PortfolioSection
            id="my-work"
            title={localizedCopy.work.title}
            description={localizedCopy.work.description}
        >
            <StandoutStory copy={localizedCopy} />
        </PortfolioSection>

        <BannerQuote id="projects-banner" quote={localizedCopy.organisations.quote} subquote="">
            <div class="flex flex-col gap-4 pt-4">
                <div class="flex text-canvas text-lg">{localizedCopy.organisations.introduction}</div>
                <PartnerLogoCarousel
                    partners={[
                        { src: '/assets/companies/netcom.svg', alt: 'NetCom Sicherheitstechnik' },
                        { src: '/assets/companies/kpmg.svg', alt: 'KPMG' },
                        { src: '/assets/companies/uds.svg.webp', alt: 'Saarland University' },
                        { src: '/assets/companies/gip_logo_neg.png', alt: 'GIP Exyr', className: 'brightness-0 invert' },
                        { src: '/assets/companies/IGS_NiederOlm_farbig.jpg', alt: 'IGS Nieder Olm' },
                        { src: '/assets/companies/kclogo.svg', alt: 'KuppingerCole Analysts' },
                        { src: '/assets/companies/UNIPD_Marchio_STD_RED.png', alt: 'University of Padua' },

                    ]}
                />
            </div>
        </BannerQuote>

        <!-- My Projects -->
        <PortfolioSection
            id="my-projects"
            title={localizedCopy.projects.title}
            description={localizedCopy.projects.description}
            noPadding
        >
            <div class="grid gap-8">
                <ProjectCarousel projects={projects} tags={projectTags} copy={localizedCopy} />
                <div class="grid gap-5 flex flex-col">
                    <p class="text-lg leading-relaxed text-muted-strong lg:max-w-2/3">
                        {localizedCopy.projects.selected}
                    </p>
                    <div class="flex flex-wrap gap-3">
                        <ActionLink href="#tech-stack-banner" icon="iconoir:arrow-down">{localizedCopy.projects.exploreStack}</ActionLink>
                        <ActionLink href="#contact" variant="secondary" icon="iconoir:arrow-down">{localizedCopy.projects.contact}</ActionLink>
                    </div>
                </div>
            </div>
        </PortfolioSection>

        <BannerQuote
            id="tech-stack-banner"
            quote={localizedCopy.stack.quote}
            subquote={localizedCopy.stack.subquote}
        />

        <!-- My Tech Stack -->
        <PortfolioSection
            id="tech-stack"
            title={localizedCopy.stack.title}
            description={localizedCopy.stack.description}
            noPadding
        >
            <div class="grid gap-4">
                <TechStack copy={localizedCopy} />
                <p class="text-lg leading-relaxed text-muted-strong opacity-50"><Icon name="iconoir:asterisk" class="mr-1 inline-block h-4 w-4 align-[-0.15em]" aria-hidden="true" />{localizedCopy.stack.selectionNote}</p>
                <div class="flex flex-col items-start gap-4 pt-4">
                    <p class="text-lg leading-relaxed text-muted-strong">{localizedCopy.stack.questions}</p>
                    <ActionLink href="#contact" icon="iconoir:arrow-down">{localizedCopy.projects.contact}</ActionLink>
                </div>
            </div>
        </PortfolioSection>

        <BannerQuote
            id="contact"
            quote={localizedCopy.contact.quote}
            subquote={localizedCopy.contact.subquote}
        />

        <!-- Contact -->
        <PortfolioSection
            id="contact"
            title={localizedCopy.contact.title}
            description={localizedCopy.contact.description}
        >
            <ContactOptions copy={localizedCopy} />
        </PortfolioSection>

        <Footer copy={localizedCopy} locale={locale} />
    </div>
</BaseLayout>
