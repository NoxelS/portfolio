---
import BaseLayout from '../layouts/BaseLayout.astro';
const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL?.replace(/\/$/, '') ?? '';
---

<BaseLayout title="Noel Schwabenland">
	<section class="mx-auto flex min-h-[calc(100vh-5rem)] max-w-4xl flex-col justify-center gap-6">
		<p class="text-sm font-medium uppercase tracking-[0.3em] text-cyan-300/80">Portfolio</p>
		<h1 class="max-w-2xl text-5xl font-semibold tracking-tight text-slate-50 sm:text-6xl">Noel Schwabenland</h1>
		<p class="text-lg leading-8 text-slate-300">
			Building a fast, self-hosted portfolio with strong performance, privacy-conscious analytics, and clear technical insight.
		</p>
		<p class="rounded-lg border border-slate-800 bg-sky-500 px-4 py-3 text-sm leading-6 text-slate-300">
			Not impressed with the assistant's response? Fair enough.
			This entire stack, including the RAG pipeline, runs on 8 GB of RAM and a 360M parameter model, which is probably still less memory than your browser needed just to open this page.
		</p>
		<div id="sales-assistant-root" data-api-base-url={apiBaseUrl}></div>
		<script type="module">
			const root = document.getElementById('sales-assistant-root');

			if (!root) {
				throw new Error('Sales assistant root missing.');
			}

			const apiBaseUrl = root.dataset.apiBaseUrl?.replace(/\/$/, '') ?? '';
			let currentSource;
			let currentStatusItems = [];
			const form = document.createElement('form');
			form.className = 'w-full rounded-2xl border border-slate-700 bg-slate-900/70 p-4 shadow-lg shadow-black/10';

			const label = document.createElement('label');
			label.className = 'text-sm font-medium text-slate-200';
			label.htmlFor = 'sales-assistant-query';
			label.textContent = 'Ask the sales assistant';

			const row = document.createElement('div');
			row.className = 'flex flex-col gap-3 sm:flex-row';

			const input = document.createElement('input');
			input.id = 'sales-assistant-query';
			input.className = 'flex-1 rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-slate-100 outline-none placeholder:text-slate-500 focus:border-cyan-400';
			input.type = 'text';
			input.placeholder = 'Ask about services, pricing, or fit';

			const button = document.createElement('button');
			button.className = 'rounded-lg bg-cyan-400 px-4 py-2 font-medium text-slate-950 transition hover:bg-cyan-300 disabled:cursor-not-allowed disabled:opacity-60';
			button.type = 'submit';
			button.textContent = 'Send';

			const error = document.createElement('p');
			error.className = 'mt-3 text-sm text-red-300';
			error.hidden = true;

			const response = document.createElement('div');
			response.className = 'mt-4 space-y-4 rounded-2xl border border-slate-700 bg-slate-900/70 p-4 shadow-lg shadow-black/10';
			response.hidden = true;

			const responseLabel = document.createElement('p');
			responseLabel.className = 'text-xs uppercase tracking-[0.25em] text-slate-400';
			responseLabel.textContent = 'Response';

			const statusLabel = document.createElement('p');
			statusLabel.className = 'text-xs uppercase tracking-[0.25em] text-slate-400';
			statusLabel.textContent = 'Status';

			const statusList = document.createElement('ul');
			statusList.className = 'space-y-2';

			const responseBody = document.createElement('p');
			responseBody.className = 'mt-1 whitespace-pre-wrap text-slate-100';

			const responseDisclaimer = document.createElement('p');
			responseDisclaimer.className = 'mt-3 text-sm leading-6 text-slate-400';
			responseDisclaimer.textContent = 'I do not guarantee any generated response. Concrete numbers should always be checked back with me.';

			const sourcesLabel = document.createElement('p');
			sourcesLabel.className = 'text-xs uppercase tracking-[0.25em] text-slate-400';
			sourcesLabel.textContent = 'Sources';

			const sourcesList = document.createElement('ul');
			sourcesList.className = 'mt-2 space-y-2';

			const responseSection = document.createElement('div');
			responseSection.append(responseLabel, responseBody, responseDisclaimer);

			const sourcesSection = document.createElement('div');
			sourcesSection.append(sourcesLabel, sourcesList);

			const statusSection = document.createElement('div');
			statusSection.append(statusLabel, statusList);

			response.append(statusSection, responseSection, sourcesSection);
			row.append(input, button);
			form.append(label, row, error);
			root.replaceChildren(form, response);

			function setError(message) {
				error.textContent = message;
				error.hidden = !message;
			}

			function setLoading(loading) {
				button.disabled = loading;
				button.textContent = loading ? 'Sending...' : 'Send';
			}

			function formatDuration(durationMs) {
				if (typeof durationMs !== 'number') {
					return '';
				}

				if (durationMs < 1000) {
					return `${durationMs}ms`;
				}

				return `${(durationMs / 1000).toFixed(1)}s`;
			}

			const STEP_DESCRIPTIONS = {
				query: 'The user query is being prepared.',
				rewrite: 'The query was rewritten into search-friendly terms to improve retrieval.',
				embedding: 'The query was converted into a vector embedding for semantic search.',
				retrieval: 'Similar content chunks are being retrieved from the vector database.',
				merge: 'Results from multiple retrieval passes are being merged and deduplicated.',
				rerank: 'Retrieved chunks are being reranked by relevance to the query.',
				filter: 'Low-confidence results below the relevance threshold are being removed.',
				packing: 'Context is being packed within the available model token budget.',
				prompt: 'The final prompt is being assembled.',
				rag_query: 'The full prompt sent to the model for debugging.',
				generation: 'The model is generating an answer from the packed context.',
				fallback: 'No relevant context was found — returning the fallback response.',
			};

			function getStepDescription(stage) {
				return STEP_DESCRIPTIONS[stage] ?? '';
			}

			function renderValue(value) {
				if (value === null || value === undefined) return String(value);
				if (typeof value === 'object') return JSON.stringify(value, null, 2);
				return String(value);
			}

			function renderDebug(debug, container) {
				if (!debug || typeof debug !== 'object') return;

				for (const [key, value] of Object.entries(debug)) {
					if (Array.isArray(value) && value.length > 0 && typeof value[0] === 'object') {
						const label = document.createElement('p');
						label.className = 'mt-2 text-xs font-medium text-slate-300';
						label.textContent = key.replace(/_/g, ' ');
						container.append(label);

						for (const item of value) {
							if (item && typeof item === 'object' && item.note) {
								const note = document.createElement('p');
								note.className = 'text-[11px] text-slate-500 italic';
								note.textContent = item.note;
								container.append(note);
								continue;
							}

							const card = document.createElement('div');
							card.className = 'rounded border border-slate-800 bg-slate-950/50 p-2 text-[11px] text-slate-400';

							const title = document.createElement('p');
							title.className = 'font-medium text-slate-200';
							title.textContent = item.title ?? item.message ?? '(unnamed)';
							card.append(title);

							if (item.path) {
								const line = document.createElement('p');
								line.className = 'text-slate-500';
								line.textContent = `path: ${item.path}`;
								card.append(line);
							}

							if (item.relevance !== undefined) {
								const line = document.createElement('p');
								line.className = 'text-slate-500';
								line.textContent = `relevance: ${typeof item.relevance === 'number' ? item.relevance.toFixed(2) : item.relevance}`;
								card.append(line);
							}

							if (item.rerank_score !== undefined) {
								const line = document.createElement('p');
								line.className = 'text-slate-500';
								line.textContent = `score: ${typeof item.rerank_score === 'number' ? item.rerank_score.toFixed(4) : item.rerank_score}`;
								card.append(line);
							}

							if (item.content_preview) {
								const line = document.createElement('p');
								line.className = 'mt-1 text-slate-500';
								line.textContent = item.content_preview;
								card.append(line);
							}

							container.append(card);
						}
						continue;
					}

					if (Array.isArray(value) && typeof value[0] === 'string') {
						const label = document.createElement('p');
						label.className = 'mt-1 text-xs font-medium text-slate-300';
						label.textContent = key.replace(/_/g, ' ');
						container.append(label);

						for (const str of value) {
							const line = document.createElement('p');
							line.className = 'text-[11px] text-slate-400';
							line.textContent = str;
							container.append(line);
						}
						continue;
					}

					if (typeof value === 'object') {
						const label = document.createElement('p');
						label.className = 'mt-1 text-xs font-medium text-slate-300';
						label.textContent = key.replace(/_/g, ' ');
						container.append(label);

						const pre = document.createElement('pre');
						pre.className = 'max-h-32 overflow-auto rounded border border-slate-800 bg-slate-950 p-1.5 text-[11px] text-slate-400';
						pre.textContent = renderValue(value);
						container.append(pre);
						continue;
					}

					const line = document.createElement('p');
					line.className = 'text-[11px] text-slate-400';
					line.textContent = `${key.replace(/_/g, ' ')}: ${renderValue(value)}`;
					container.append(line);
				}
			}

			function renderStatusItem(payload) {
				const item = document.createElement('li');
				item.className = 'text-xs text-slate-400';

				const details = document.createElement('details');
				details.className = 'group';
				details.open = false;

				const summary = document.createElement('summary');
				summary.className = 'flex cursor-pointer items-center justify-between gap-2 rounded-lg py-1 hover:bg-slate-800/40';

				const titleRow = document.createElement('div');
				titleRow.className = 'flex items-center gap-2';

				const arrow = document.createElement('span');
				arrow.className = 'text-slate-500 transition-transform group-open:rotate-90';
				arrow.textContent = '▸';

				const message = document.createElement('span');
				message.className = 'font-medium text-slate-100';
				message.textContent = payload.message ?? 'Step';

				titleRow.append(arrow, message);

				const duration = document.createElement('span');
				duration.className = 'text-[11px] text-slate-500';
				duration.textContent = payload.duration_ms != null ? formatDuration(payload.duration_ms) : '';

				summary.append(titleRow, duration);

				const body = document.createElement('div');
				body.className = 'ml-4 mt-1 space-y-1 pb-2';

				const description = document.createElement('p');
				description.className = 'text-[11px] text-slate-500';
				description.textContent = getStepDescription(payload.stage);

				if (description.textContent) {
					body.append(description);
				}

				if (payload.rewritten_query && payload.stage === 'rewrite') {
					const line = document.createElement('p');
					line.className = 'text-[11px] text-slate-400';
					line.textContent = `rewritten: ${payload.rewritten_query}`;
					body.append(line);
				}

				if (payload.model) {
					const line = document.createElement('p');
					line.className = 'text-[11px] text-slate-400';
					line.textContent = `model: ${payload.model}`;
					body.append(line);
				}

				const counts = payload.counts;
				if (counts && typeof counts === 'object') {
					for (const [key, value] of Object.entries(counts)) {
						const line = document.createElement('p');
						line.className = 'text-[11px] text-slate-400';
						line.textContent = `${key}: ${value}`;
						body.append(line);
					}
				}

				if (payload.debug) {
					const divider = document.createElement('hr');
					divider.className = 'my-2 border-slate-800';
					body.append(divider);
					renderDebug(payload.debug, body);
				}

				if (payload.rag_query) {
					const label = document.createElement('p');
					label.className = 'mt-2 text-xs font-medium text-slate-300';
					label.textContent = 'Full RAG query:';
					body.append(label);

					const pre = document.createElement('pre');
					pre.className = 'mt-1 max-h-48 overflow-auto rounded-lg border border-slate-800 bg-slate-950 p-2 text-[11px] text-slate-300';
					pre.textContent = payload.rag_query;
					body.append(pre);
				}

				details.append(summary, body);
				item.append(details);
				return item;
			}

			function resetStatusLog() {
				statusList.replaceChildren();
				currentStatusItems = [];
			}

			function closeStream() {
				if (currentSource) {
					currentSource.close();
					currentSource = undefined;
				}
			}

			function renderSources(items) {
				sourcesList.replaceChildren();

				for (const [index, source] of items.entries()) {
					const li = document.createElement('li');
					li.className = 'rounded-lg border border-slate-800 bg-slate-950/70 p-3 text-sm text-slate-300';

					const title = document.createElement('p');
					title.className = 'font-medium text-slate-100';
					title.textContent = source.title ?? source.path ?? `Source ${index + 1}`;

					li.append(title);

					if (source.path) {
						const path = document.createElement('p');
						path.className = 'mt-1 text-slate-400';
						path.textContent = source.path;
						li.append(path);
					}

					if (source.content_type) {
						const type = document.createElement('p');
						type.className = 'mt-1 text-slate-500';
						type.textContent = source.content_type;
						li.append(type);
					}

					if (source.relevance != null) {
						const relevance = document.createElement('p');
						relevance.className = 'mt-1 text-slate-500';
						relevance.textContent = `Relevance: ${String(source.relevance)}`;
						li.append(relevance);
					}

					if (source.content) {
						const content = document.createElement('p');
						content.className = 'mt-2 line-clamp-3 text-slate-400';
						content.textContent = source.content;
						li.append(content);
					}

					sourcesList.append(li);
				}
			}

			form.addEventListener('submit', async (event) => {
				event.preventDefault();

				const query = input.value.trim();

				if (!query) {
					setError('Enter a question first.');
					return;
				}

				if (!apiBaseUrl) {
					setError('Set PUBLIC_API_BASE_URL in the frontend env.');
					return;
				}

				closeStream();

				setError('');
				setLoading(true);
				response.hidden = true;
				responseBody.textContent = '';
				sourcesList.replaceChildren();
				resetStatusLog();
				const url = new URL(`${apiBaseUrl}/sales-assistant`);
				url.searchParams.set('query', query);

				currentSource = new EventSource(url.toString());

				currentSource.addEventListener('step', (event) => {
					const payload = JSON.parse(event.data);
					const item = renderStatusItem(payload);
					currentStatusItems.push(item);
					item.dataset.message = payload.message ?? 'Step';
					statusList.append(item);
					response.hidden = false;
				});

				currentSource.addEventListener('token', (event) => {
					response.hidden = false;
					responseBody.textContent += event.data ?? '';
				});

				currentSource.addEventListener('sources', (event) => {
					const payload = JSON.parse(event.data);
					renderSources(Array.isArray(payload.results) ? payload.results : []);
					response.hidden = false;
				});

				currentSource.addEventListener('done', () => {
					setLoading(false);
					closeStream();
				});

				currentSource.addEventListener('error', () => {
					setLoading(false);
					setError('Stream failed.');
					closeStream();
				});
			});
		</script>
	</section>
</BaseLayout>
