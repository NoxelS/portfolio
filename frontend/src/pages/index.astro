---
/**
 * Portfolio landing page — top-level route.
 *
 * Composes the full-page layout: hero (LandingPage), alternating banner
 * quotes, and section blocks (Projects, TechStack, Contact, Footer).
 * The project data constant below is also consumed by ProjectCarousel
 * once it is wired into the "My Projects" section.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingPage from '../components/LandingPage.astro';
import ProjectCarousel from '../components/ProjectCarousel.astro';
import BannerQuote from '../components/BannerQuote.astro';
import PortfolioSection from '../components/PortfolioSection.astro';
import StandoutStory from '../components/StandoutStory.astro';
import PartnerLogoCarousel from '../components/PartnerLogoCarousel.astro';

const projects = [
    {
        title: 'AI Transformation @ NetCom',
        description: `### Process automation

Lorem ipsum dolor sit amet, **consectetur adipiscing elit**. Integer nec odio praesent libero sed cursus ante dapibus diam.

- Sed nisi nulla, quis sem at nibh elementum imperdiet.
- Duis sagittis ipsum, praesent mauris fusce nec tellus.`,
        link: '/projects/project1',
        logoSrc: '/assets/companies/netcom.svg',
        logoAlt: 'NetCom logo'
    },
    {
        title: 'Data & AI Consulting @ KPMG',
        description: `### Analytics delivery

Lorem ipsum dolor sit amet, consectetur adipiscing elit. **Praesent mauris** fusce nec tellus sed augue semper porta.

> Mauris massa vestibulum lacinia arcu eget nulla class aptent taciti sociosqu.`,
        link: '/projects/project2',
        logoSrc: '/assets/companies/kpmg.svg',
        logoAlt: 'KPMG logo'
    },
    {
        title: 'CNN Model Development for Drug Discovery @ UDS',
        description: `### Research prototype

Lorem ipsum dolor sit amet, consectetur adipiscing elit. Curabitur sodales ligula in libero sed dignissim lacinia nunc.

1. Class aptent taciti sociosqu ad litora torquent.
2. Curabitur tortor pellentesque nibh aenean quam.`,
        link: '/projects/project3',
        logoSrc: '/assets/companies/uds.png',
        logoAlt: 'Saarland University logo'
    },
    {
        title: 'CMS Product Ownership',
        description: `### Product operations

Lorem ipsum dolor sit amet, **adipiscing elit**. Sed dignissim lacinia nunc curabitur tortor pellentesque nibh.

Vivamus elementum semper nisi. Aenean vulputate eleifend tellus.`,
        link: '/projects/project3',
        logoSrc: '/assets/companies/gip_logo_neg.png',
        logoAlt: 'GIP Exyr logo'
    }
];
---

<BaseLayout title="Noel Schwabenland">
    <LandingPage />

    <div class="grid w-full min-w-0 grid-cols-1 gap-8 px-4 md:px-8">
        <BannerQuote
            quote="Complex problems don't always require complex solutions"
            subquote="Sometimes the simplest approach is the best. My background in both technical and business domains allows me to bridge the gap between these worlds."
        />

        <!-- Who I Am -->
        <PortfolioSection
            id="my-work"
            eyebrow="How I work"
            title="From complex questions to useful decisions"
            description="I combine scientific rigor with practical software engineering to build AI systems that hold up in real operations."
        >
            <StandoutStory />
        </PortfolioSection>

        <BannerQuote quote="Not only theory, but proven practice" subquote="">
            <div class="flex flex-col gap-4 pt-4">
                <div class="flex text-white text-lg">I already got the chance to have contributed alongside some awesome organisations:</div>
                <PartnerLogoCarousel
                    partners={[
                        { src: '/assets/companies/netcom.svg', alt: 'NetCom Sicherheitstechnik' },
                        { src: '/assets/companies/kpmg.svg', alt: 'KPMG' },
                        { src: '/assets/companies/uds.png', alt: 'Saarland University' },
                        { src: '/assets/companies/gip_logo_neg.png', alt: 'GIP Exyr', className: 'brightness-0 invert' },
                        { src: '/assets/companies/IGS_NiederOlm_farbig.jpg', alt: 'IGS Nieder Olm' },
                        { src: '/assets/companies/kclogo.svg', alt: 'KuppingerCole Analysts' }
                    ]}
                />
            </div>
        </BannerQuote>

        <!-- My Projects -->
        <PortfolioSection
            id="my-projects"
            eyebrow="Selected work"
            title="My Projects"
            description="Project cards are data-driven, so this section is ready for real case-study content."
        >
            <ProjectCarousel projects={projects} />
        </PortfolioSection>

        <BannerQuote quote="From Ideas and Requirements to Reality" subquote="With a broad skill set and a passion for learning, I help bring ideas to life." />

        <!-- My Tech Stack -->
        <PortfolioSection
            id="my-tech-stack"
            eyebrow="Capabilities"
            title="My Tech Stack"
            description="Use this area for the tools, systems, and working principles you want to foreground."
        />

        <BannerQuote
            quote="I prefer human interaction"
            subquote="Even though I work in cooperation with artificial intelligence, I believe that personal connections are irreplaceable. So I always make time for face-to-face meetings and conversations."
        />

        <!-- Contact -->
        <PortfolioSection
            id="contact"
            eyebrow="Start a conversation"
            title="Contact"
            description="A dedicated contact block, ready for your preferred form, calendar link, or direct details."
        />

        <!-- Footer -->
        <PortfolioSection id="footer" title="Noel Schwabenland" />
    </div>
</BaseLayout>
