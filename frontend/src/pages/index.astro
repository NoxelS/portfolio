---

<BaseLayout title="Noel Schwabenland">
	<LandingPage />

	<div class="grid gap-8">
		<!-- Who I Am -->
		<section id="my-work" class="px-3 py-[var(--site-section-block)] sm:px-4 lg:px-6 border border-accent/20 gap-4 overflow-hidden">
			<h4 class="uppercase text-5xl lora">My Work</h4>
			<p class="text-gray-500 text-lg">Only recent projects are shown here. More information upon request.</p>
			<div class="mt-4">
				<ProjectCarousel projects={projects} />
			</div>
		</section>

		<!-- My Background -->
		<section id="my-background" class="px-3 py-[var(--site-section-block)] sm:px-4 lg:px-6 border border-accent/20">
			<h4 class="uppercase text-5xl lora">My Background</h4>
			<p class="text-muted-strong">Coming soon.</p>
		</section>

		<!-- My Tech Stack -->
		<section id="my-tech-stack" class="px-3 py-[var(--site-section-block)] sm:px-4 lg:px-6 border border-accent/20">
			<h4 class="uppercase text-5xl lora">My Tech Stack</h4>
			<p class="text-muted-strong">Coming soon.</p>
		</section>

		<!-- Contact -->
		<section id="contact" class="px-3 py-[var(--site-section-block)] sm:px-4 lg:px-6 border border-accent/20">
			<h4 class="uppercase text-5xl lora">Contact</h4>
			<p class="text-muted-strong">Coming soon.</p>
		</section>
	</div>
</BaseLayout>
