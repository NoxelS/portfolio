---
/**
 * Portfolio landing page — top-level route.
 *
 * Composes the full-page layout: hero (LandingPage), alternating banner
 * quotes, and section blocks (Projects, TechStack, Contact, Footer).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingPage from '../components/LandingPage.astro';
import ProjectCarousel from '../components/ProjectCarousel.astro';
import BannerQuote from '../components/BannerQuote.astro';
import PortfolioSection from '../components/PortfolioSection.astro';
import StandoutStory from '../components/StandoutStory.astro';
import PartnerLogoCarousel from '../components/PartnerLogoCarousel.astro';
import TechStack from '../components/TechStack.astro';
import ContactOptions from '../components/ContactOptions.astro';
import Footer from '../components/Footer.astro';
import ActionLink from '../components/ActionLink.astro';
import { Icon } from 'astro-icon/components';
import { getAllTags, getSortedProjects } from '../data/projects';

const projects = getSortedProjects();
const projectTags = getAllTags();
---

<BaseLayout title="Noel Schwabenland">
    <LandingPage />

    <div class="grid w-full min-w-0 grid-cols-1 gap-8 px-4 md:px-8">
        <BannerQuote
            id="work-banner"
            quote="Complex problems don't always require complex solutions"
            subquote="Sometimes the simplest approach is the best. My background in both technical and business domains allows me to bridge the gap between these worlds."
        />

        <!-- Who I Am -->
        <PortfolioSection
            id="my-work"
            title="How I work"
            description="I combine scientific curiosity with practical software engineering to build AI systems that hold up in real operations."
        >
            <StandoutStory />
        </PortfolioSection>

        <BannerQuote id="projects-banner" quote="Not only theory, but proven practice" subquote="">
            <div class="flex flex-col gap-4 pt-4">
                <div class="flex text-white text-lg">I already got the chance to have contributed alongside some awesome organisations:</div>
                <PartnerLogoCarousel
                    partners={[
                        { src: '/assets/companies/netcom.svg', alt: 'NetCom Sicherheitstechnik' },
                        { src: '/assets/companies/kpmg.svg', alt: 'KPMG' },
                        { src: '/assets/companies/uds.png', alt: 'Saarland University' },
                        { src: '/assets/companies/gip_logo_neg.png', alt: 'GIP Exyr', className: 'brightness-0 invert' },
                        { src: '/assets/companies/IGS_NiederOlm_farbig.jpg', alt: 'IGS Nieder Olm' },
                        { src: '/assets/companies/kclogo.svg', alt: 'KuppingerCole Analysts' },
                        { src: '/assets/companies/UNIPD_Marchio_STD_RED.png', alt: 'University of Padua' },

                    ]}
                />
            </div>
        </BannerQuote>

        <!-- My Projects -->
        <PortfolioSection
            id="my-projects"
            title="My Projects"
            description="From private AI platforms and voice agents to high-performance research pipelines, these projects solve real operational constraints with systems teams can use, govern, and scale."
            noPadding
        >
            <div class="grid gap-8">
                <ProjectCarousel projects={projects} tags={projectTags} />
                <div class="grid gap-5 flex flex-col">
                    <p class="text-lg leading-relaxed text-muted-strong lg:max-w-2/3">
                        These are selected projects only. If you are looking for experience in a specific area, feel free to get in touch with me.
                    </p>
                    <div class="flex flex-wrap gap-3">
                        <ActionLink href="#tech-stack-banner" icon="iconoir:arrow-down">Explore my tech stack</ActionLink>
                        <ActionLink href="#contact-banner" variant="secondary" icon="iconoir:arrow-down">Get in touch</ActionLink>
                    </div>
                </div>
            </div>
        </PortfolioSection>

        <BannerQuote
            id="tech-stack-banner"
            quote="From ideas and requirements to reality"
            subquote="With a broad skill set and a passion for learning, I help bring ideas to life."
        />

        <!-- My Tech Stack -->
        <PortfolioSection
            id="tech-stack"
            title="My Tech Stack"
            description="Quickly check whether our tech stacks already align. If a technology is missing, that's no issue. I only list technologies I'm comfortable with. I'm always ready to learn and can quickly find my way around a new stack."
            noPadding
        >
            <div class="grid gap-4">
                <TechStack />
                <p class="text-lg leading-relaxed text-muted-strong opacity-50"><Icon name="iconoir:asterisk" class="mr-1 inline-block h-4 w-4 align-[-0.15em]" aria-hidden="true" />Only a selection of the libraries and tools I use regularly is listed here.</p>
                <div class="flex flex-col items-start gap-4 pt-4">
                    <p class="text-lg leading-relaxed text-muted-strong">Any more questions?</p>
                    <ActionLink href="#contact-banner" icon="iconoir:arrow-down">Get in touch</ActionLink>
                </div>
            </div>
        </PortfolioSection>

        <BannerQuote
            id="contact-banner"
            quote="Nothing beats a real conversation"
            subquote="Even though I work with AI agents, I believe that personal connections are irreplaceable. So I always make time for face-to-face meetings and conversations."
        />

        <!-- Contact -->
        <PortfolioSection
            id="contact"
            title="Let's build awesome things together"
            description="Have a project, idea, or opportunity in mind?  Let's talk and see whether we're a good fit, and explore how we can create something valuable together."
        >
            <ContactOptions />
        </PortfolioSection>

        <Footer />
    </div>
</BaseLayout>
