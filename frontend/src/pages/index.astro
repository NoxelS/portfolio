---
import BaseLayout from '../layouts/BaseLayout.astro';
const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL?.replace(/\/$/, '') ?? '';
---

<BaseLayout title="Noel Schwabenland">
	<section class="mx-auto flex min-h-[calc(100vh-5rem)] max-w-4xl flex-col justify-center gap-6">
		<p class="text-sm font-medium uppercase tracking-[0.3em] text-cyan-300/80">Portfolio</p>
		<h1 class="max-w-2xl text-5xl font-semibold tracking-tight text-slate-50 sm:text-6xl">Noel Schwabenland</h1>
		<p class="max-w-xl text-lg leading-8 text-slate-300">
			Building a fast, self-hosted portfolio with strong performance, privacy-conscious analytics, and clear technical insight.
		</p>
		<p class="max-w-2xl rounded-lg border border-slate-800 bg-slate-900/60 px-4 py-3 text-sm leading-6 text-slate-300">
			I run my own LLM infrastructure. To keep this free and cost-efficient, I only run small models here, so don&apos;t expect Opus-level answers.
		</p>
		<div id="sales-assistant-root" data-api-base-url={apiBaseUrl}></div>
		<script type="module">
			const root = document.getElementById('sales-assistant-root');

			if (!root) {
				throw new Error('Sales assistant root missing.');
			}

			const apiBaseUrl = root.dataset.apiBaseUrl?.replace(/\/$/, '') ?? '';
			let currentSource;
			let currentStatusItems = [];
			let requestStartedAt = 0;
			const form = document.createElement('form');
			form.className = 'w-full max-w-2xl rounded-2xl border border-slate-700 bg-slate-900/70 p-4 shadow-lg shadow-black/10';

			const label = document.createElement('label');
			label.className = 'text-sm font-medium text-slate-200';
			label.htmlFor = 'sales-assistant-query';
			label.textContent = 'Ask the sales assistant';

			const row = document.createElement('div');
			row.className = 'flex flex-col gap-3 sm:flex-row';

			const input = document.createElement('input');
			input.id = 'sales-assistant-query';
			input.className = 'flex-1 rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-slate-100 outline-none placeholder:text-slate-500 focus:border-cyan-400';
			input.type = 'text';
			input.placeholder = 'Ask about services, pricing, or fit';

			const button = document.createElement('button');
			button.className = 'rounded-lg bg-cyan-400 px-4 py-2 font-medium text-slate-950 transition hover:bg-cyan-300 disabled:cursor-not-allowed disabled:opacity-60';
			button.type = 'submit';
			button.textContent = 'Send';

			const error = document.createElement('p');
			error.className = 'mt-3 text-sm text-red-300';
			error.hidden = true;

			const response = document.createElement('div');
			response.className = 'mt-4 space-y-4 rounded-2xl border border-slate-700 bg-slate-900/70 p-4 shadow-lg shadow-black/10';
			response.hidden = true;

			const responseLabel = document.createElement('p');
			responseLabel.className = 'text-xs uppercase tracking-[0.25em] text-slate-400';
			responseLabel.textContent = 'Response';

			const statusLabel = document.createElement('p');
			statusLabel.className = 'text-xs uppercase tracking-[0.25em] text-slate-400';
			statusLabel.textContent = 'Status';

			const statusList = document.createElement('ul');
			statusList.className = 'space-y-2';

			const responseBody = document.createElement('p');
			responseBody.className = 'mt-1 whitespace-pre-wrap text-slate-100';

			const responseDisclaimer = document.createElement('p');
			responseDisclaimer.className = 'mt-3 text-sm leading-6 text-slate-400';
			responseDisclaimer.textContent = 'I do not guarantee any generated response. Concrete numbers should always be checked back with me.';

			const sourcesLabel = document.createElement('p');
			sourcesLabel.className = 'text-xs uppercase tracking-[0.25em] text-slate-400';
			sourcesLabel.textContent = 'Sources';

			const sourcesList = document.createElement('ul');
			sourcesList.className = 'mt-2 space-y-2';

			const responseSection = document.createElement('div');
			responseSection.append(responseLabel, responseBody, responseDisclaimer);

			const sourcesSection = document.createElement('div');
			sourcesSection.append(sourcesLabel, sourcesList);

			const statusSection = document.createElement('div');
			statusSection.append(statusLabel, statusList);

			response.append(statusSection, responseSection, sourcesSection);
			row.append(input, button);
			form.append(label, row, error);
			root.replaceChildren(form, response);

			function setError(message) {
				error.textContent = message;
				error.hidden = !message;
			}

			function setLoading(loading) {
				button.disabled = loading;
				button.textContent = loading ? 'Sending...' : 'Send';
			}

			function formatDuration(durationMs) {
				if (typeof durationMs !== 'number') {
					return '';
				}

				if (durationMs < 1000) {
					return `${durationMs}ms`;
				}

				return `${(durationMs / 1000).toFixed(1)}s`;
			}

			function renderStatusItem(payload) {
				const item = document.createElement('li');
				item.className = 'text-xs text-slate-400';
				item.dataset.durationMs = String(payload.duration_ms ?? 0);

				item.textContent = formatStepLine(payload, false);
				return item;
			}

			function collapseStatusLog() {
				for (const item of currentStatusItems) {
					item.textContent = formatStepLine(
						{
							message: item.dataset.message ?? 'Step',
							duration_ms: Number(item.dataset.durationMs ?? 0),
						},
						true,
					);
				}
			}

			function formatStepLine(payload, completed) {
				const message = payload.message ?? 'Step';
				const duration = completed ? formatDuration(Number(payload.duration_ms ?? 0)) : 'working';
				const parts = [];

				if (payload.model) {
					parts.push(`model: ${payload.model}`);
				}

				const counts = payload.counts;
				if (counts && typeof counts === 'object') {
					for (const [key, value] of Object.entries(counts)) {
						parts.push(`${key}: ${value}`);
					}
				}

				if (parts.length === 0) {
					parts.push(completed ? duration : 'working');
				}

				return `${message} - ${parts.join(' - ')}${completed ? '' : ` - ${duration}`}`;
			}

			function resetStatusLog() {
				statusList.replaceChildren();
				currentStatusItems = [];
			}

			function closeStream() {
				if (currentSource) {
					currentSource.close();
					currentSource = undefined;
				}
			}

			function renderSources(items) {
				sourcesList.replaceChildren();

				for (const [index, source] of items.entries()) {
					const li = document.createElement('li');
					li.className = 'rounded-lg border border-slate-800 bg-slate-950/70 p-3 text-sm text-slate-300';

					const title = document.createElement('p');
					title.className = 'font-medium text-slate-100';
					title.textContent = source.title ?? source.path ?? `Source ${index + 1}`;

					li.append(title);

					if (source.path) {
						const path = document.createElement('p');
						path.className = 'mt-1 text-slate-400';
						path.textContent = source.path;
						li.append(path);
					}

					if (source.content_type) {
						const type = document.createElement('p');
						type.className = 'mt-1 text-slate-500';
						type.textContent = source.content_type;
						li.append(type);
					}

					if (source.relevance != null) {
						const relevance = document.createElement('p');
						relevance.className = 'mt-1 text-slate-500';
						relevance.textContent = `Relevance: ${String(source.relevance)}`;
						li.append(relevance);
					}

					if (source.content) {
						const content = document.createElement('p');
						content.className = 'mt-2 line-clamp-3 text-slate-400';
						content.textContent = source.content;
						li.append(content);
					}

					sourcesList.append(li);
				}
			}

			form.addEventListener('submit', async (event) => {
				event.preventDefault();

				const query = input.value.trim();

				if (!query) {
					setError('Enter a question first.');
					return;
				}

				if (!apiBaseUrl) {
					setError('Set PUBLIC_API_BASE_URL in the frontend env.');
					return;
				}

				closeStream();

				setError('');
				setLoading(true);
				response.hidden = true;
				responseBody.textContent = '';
				sourcesList.replaceChildren();
				resetStatusLog();
				requestStartedAt = performance.now();
				const url = new URL(`${apiBaseUrl}/sales-assistant`);
				url.searchParams.set('query', query);

				currentSource = new EventSource(url.toString());

				currentSource.addEventListener('step', (event) => {
					const payload = JSON.parse(event.data);
				const item = renderStatusItem(payload);
				currentStatusItems.push(item);
				item.dataset.message = payload.message ?? 'Step';
				statusList.append(item);
				response.hidden = false;
			});

				currentSource.addEventListener('token', (event) => {
					response.hidden = false;
					responseBody.textContent += event.data ?? '';
				});

				currentSource.addEventListener('sources', (event) => {
					const payload = JSON.parse(event.data);
					renderSources(Array.isArray(payload.results) ? payload.results : []);
					response.hidden = false;
				});

				currentSource.addEventListener('done', () => {
					collapseStatusLog();
					requestStartedAt = 0;
					setLoading(false);
					closeStream();
				});

				currentSource.addEventListener('error', () => {
					setLoading(false);
					setError('Stream failed.');
					closeStream();
				});
			});
		</script>
	</section>
</BaseLayout>
