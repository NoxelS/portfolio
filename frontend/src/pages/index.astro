---
import BaseLayout from '../layouts/BaseLayout.astro';
const apiBaseUrl = process.env.PUBLIC_API_BASE_URL?.replace(/\/$/, '') ?? '';
---

<BaseLayout title="Noel Schwabenland">
	<section class="mx-auto flex min-h-[calc(100vh-3rem)] w-full max-w-none flex-col justify-center gap-6">
		<p class="text-eyebrow text-accent">Portfolio</p>
		<h1 class="heading-hero grid max-w-full gap-2 overflow-hidden break-words">
			<span class="text-outline-primary">Noel</span>
			<span class="text-accent">Schwabenland</span>
		</h1>
		<p class="text-lead">
			Building a fast, self-hosted RAG-based portfolio with strong performance, privacy, and clear technical insight.
		</p>
		<div id="digital-twin-root" data-api-base-url={apiBaseUrl}></div>
		<template id="rag-send-button-template">
			<button class="btn btn-primary btn-primary-md focus-ring" type="submit">
				<span class="btn-label" data-button-label>Send</span>
			</button>
		</template>
		<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
		<script type="module">
			const root = document.getElementById('digital-twin-root');
			const buttonTemplate = document.getElementById('rag-send-button-template');

			if (!root) {
				throw new Error('Digital Twin root missing.');
			}

			if (!(buttonTemplate instanceof HTMLTemplateElement)) {
				throw new Error('Digital Twin button template missing.');
			}

			const apiBaseUrl = root.dataset.apiBaseUrl?.replace(/\/$/, '') ?? '';
			let currentSource;
			let currentStatusItems = [];
			let markdownText = '';
			const form = document.createElement('form');
			form.className = 'surface w-full p-4';

			const label = document.createElement('label');
			label.className = 'mb-2 block text-eyebrow text-accent';
			label.htmlFor = 'digital-twin-query';
			label.textContent = 'Ask the Digital Twin';

			const row = document.createElement('div');
			row.className = 'flex flex-col gap-3 sm:flex-row';

			const input = document.createElement('input');
			input.id = 'digital-twin-query';
			input.className = 'focus-ring flex-1 border border-border bg-white px-3 py-2 text-foreground outline-none placeholder:text-muted focus:border-accent';
			input.type = 'text';
			input.placeholder = 'Ask about my experience, projects, or skills...';

			const button = buttonTemplate.content.firstElementChild.cloneNode(true);
			const buttonLabel = button.querySelector('[data-button-label]') ?? button;

			const error = document.createElement('p');
			error.className = 'mt-3 text-sm text-danger';
			error.hidden = true;

			const response = document.createElement('div');
			response.className = 'surface mt-4 space-y-4 p-4';
			response.hidden = true;

			const responseLabel = document.createElement('p');
			responseLabel.className = 'text-meta';
			responseLabel.textContent = 'Response';

			const statusToggle = document.createElement('details');
			statusToggle.className = 'group';
			statusToggle.open = true;

			const statusSummary = document.createElement('summary');
			statusSummary.className = 'flex cursor-pointer items-center gap-2 text-meta';

			const statusArrow = document.createElement('span');
			statusArrow.className = 'text-muted transition-transform group-open:rotate-90';
			statusArrow.textContent = '▸';

			const statusLabel = document.createElement('span');
			statusLabel.textContent = 'Status';

			statusSummary.append(statusArrow, statusLabel);

			const statusBody = document.createElement('div');
			statusBody.className = 'ml-2 mt-2 space-y-2';

			const statusList = document.createElement('ul');
			statusList.className = 'space-y-2';

			const statusLoading = document.createElement('p');
			statusLoading.className = 'animate-pulse text-xs text-muted-strong italic';
			statusLoading.textContent = 'Doing magical stuff...';
			statusLoading.hidden = true;

			statusBody.append(statusList, statusLoading);
			statusToggle.append(statusSummary, statusBody);

			const responseBody = document.createElement('div');
			responseBody.className = 'prose max-w-none text-sm prose-a:text-accent prose-headings:text-foreground prose-p:text-muted-strong';

			const responseDisclaimer = document.createElement('p');
			responseDisclaimer.className = 'mt-3 text-caption';
			responseDisclaimer.textContent = 'This response was generated by an AI assistant and may not be fully accurate. Do not rely on it without verification. This is only a demo — the AI is not a legal entity. Always talk to me first personally.';

			const sourcesLabel = document.createElement('p');
			sourcesLabel.className = 'text-meta';
			sourcesLabel.textContent = 'Sources';

			const sourcesList = document.createElement('ul');
			sourcesList.className = 'mt-2 space-y-2';

			const responseSection = document.createElement('div');
			responseSection.append(responseLabel, responseBody, responseDisclaimer);

			const sourcesSection = document.createElement('div');
			sourcesSection.append(sourcesLabel, sourcesList);

			const infoBar = document.createElement('p');
			infoBar.className = 'border border-warning bg-powder-petal-50 px-4 py-3 text-sm leading-6 text-foreground';
			infoBar.textContent = 'Not impressed with the assistant\'s response? Fair enough. This entire stack, including the RAG pipeline, runs on 8 GB of RAM and a 360M parameter model, which is probably still less memory than your browser needed just to open this page.';
			infoBar.hidden = true;

			response.append(statusToggle, infoBar, responseSection, sourcesSection);
			const templates = [
				'What did you work on in your time at the computational physics department?',
				'What are your favorite projects that you\'ve worked on?',
				'What are your experiences with machine learning and AI?',
			];

			const templatesLabel = document.createElement('p');
			templatesLabel.className = 'text-meta';
			templatesLabel.textContent = 'Or use a demo prompt';

			const templatesContainer = document.createElement('div');
			templatesContainer.className = 'flex flex-wrap gap-2';

			const templatesWrapper = document.createElement('div');
			templatesWrapper.className = 'mt-3 space-y-1';

			for (const text of templates) {
				const chip = document.createElement('button');
				chip.type = 'button';
				chip.className = 'focus-ring border border-border bg-white px-3 py-1 text-xs text-accent transition hover:border-accent hover:bg-surface';
				chip.textContent = text;
				chip.addEventListener('click', () => {
					input.value = text;
					form.requestSubmit();
				});
				templatesContainer.append(chip);
			}

			row.append(input, button);
			templatesWrapper.append(templatesLabel, templatesContainer);
			form.append(label, row, templatesWrapper, error);
			root.replaceChildren(form, response);

			function setError(message) {
				error.textContent = message;
				error.hidden = !message;
			}

			function setLoading(loading) {
				button.disabled = loading;
				buttonLabel.textContent = loading ? 'Sending...' : 'Send';
			}

			function formatDuration(durationMs) {
				if (typeof durationMs !== 'number') {
					return '';
				}

				if (durationMs < 1000) {
					return `${durationMs}ms`;
				}

				return `${(durationMs / 1000).toFixed(1)}s`;
			}

			const STEP_DESCRIPTIONS = {
				query: 'The user query is being prepared.',
				rewrite: 'The query was rewritten into search-friendly terms to improve retrieval.',
				embedding: 'The query was converted into a vector embedding for semantic search.',
				retrieval: 'Similar content chunks are being retrieved from the vector database.',
				merge: 'Results from multiple retrieval passes are being merged and deduplicated.',
				rerank: 'Retrieved chunks are being reranked by relevance to the query.',
				filter: 'Low-confidence results below the relevance threshold are being removed.',
				packing: 'Context is being packed within the available model token budget.',
				prompt: 'The final prompt is being assembled.',
				rag_query: 'The full prompt sent to the model for debugging.',
				generation: 'The model is generating an answer from the packed context.',
				fallback: 'No relevant context was found — returning the fallback response.',
			};

			function getStepDescription(stage) {
				return STEP_DESCRIPTIONS[stage] ?? '';
			}

			function renderValue(value) {
				if (value === null || value === undefined) return String(value);
				if (typeof value === 'object') return JSON.stringify(value, null, 2);
				return String(value);
			}

			function renderDebug(debug, container) {
				if (!debug || typeof debug !== 'object') return;

				for (const [key, value] of Object.entries(debug)) {
					if (Array.isArray(value) && value.length > 0 && typeof value[0] === 'object') {
						const label = document.createElement('p');
						label.className = 'mt-2 text-xs font-medium text-foreground';
						label.textContent = key.replace(/_/g, ' ');
						container.append(label);

						for (const item of value) {
							if (item && typeof item === 'object' && item.note) {
								const note = document.createElement('p');
							note.className = 'text-[11px] text-muted italic';
								note.textContent = item.note;
								container.append(note);
								continue;
							}

							const card = document.createElement('div');
						card.className = 'border border-border bg-white p-2 text-[11px] text-muted-strong';

							const title = document.createElement('p');
						title.className = 'font-medium text-foreground';
							title.textContent = item.title ?? item.message ?? '(unnamed)';
							card.append(title);

							if (item.path) {
								const line = document.createElement('p');
							line.className = 'text-muted';
								line.textContent = `path: ${item.path}`;
								card.append(line);
							}

							if (item.relevance !== undefined) {
								const line = document.createElement('p');
							line.className = 'text-muted';
								line.textContent = `relevance: ${typeof item.relevance === 'number' ? item.relevance.toFixed(2) : item.relevance}`;
								card.append(line);
							}

							if (item.rerank_score !== undefined) {
								const line = document.createElement('p');
							line.className = 'text-muted';
								line.textContent = `score: ${typeof item.rerank_score === 'number' ? item.rerank_score.toFixed(4) : item.rerank_score}`;
								card.append(line);
							}

							if (item.content_preview) {
								const line = document.createElement('p');
							line.className = 'mt-1 text-muted';
								line.textContent = item.content_preview;
								card.append(line);
							}

							container.append(card);
						}
						continue;
					}

					if (Array.isArray(value) && typeof value[0] === 'string') {
						const label = document.createElement('p');
						label.className = 'mt-1 text-xs font-medium text-foreground';
						label.textContent = key.replace(/_/g, ' ');
						container.append(label);

						for (const str of value) {
							const line = document.createElement('p');
							line.className = 'text-[11px] text-muted-strong';
							line.textContent = str;
							container.append(line);
						}
						continue;
					}

					if (typeof value === 'object') {
						const label = document.createElement('p');
						label.className = 'mt-1 text-xs font-medium text-foreground';
						label.textContent = key.replace(/_/g, ' ');
						container.append(label);

						const pre = document.createElement('pre');
						pre.className = 'max-h-32 overflow-auto border border-border bg-white p-1.5 text-[11px] text-muted-strong';
						pre.textContent = renderValue(value);
						container.append(pre);
						continue;
					}

					const line = document.createElement('p');
					line.className = 'text-[11px] text-muted-strong';
					line.textContent = `${key.replace(/_/g, ' ')}: ${renderValue(value)}`;
					container.append(line);
				}
			}

			function renderStatusItem(payload) {
				const item = document.createElement('li');
				item.className = 'text-xs text-muted-strong';

				const details = document.createElement('details');
				details.className = 'group';
				details.open = false;

				const summary = document.createElement('summary');
				summary.className = 'flex cursor-pointer items-center justify-between gap-2 py-1 hover:bg-surface';

				const titleRow = document.createElement('div');
				titleRow.className = 'flex items-center gap-2';

				const arrow = document.createElement('span');
				arrow.className = 'text-muted transition-transform group-open:rotate-90';
				arrow.textContent = '▸';

				const message = document.createElement('span');
				message.className = 'font-medium text-foreground';
				message.textContent = payload.message ?? 'Step';

				titleRow.append(arrow, message);

				const duration = document.createElement('span');
				duration.className = 'text-[11px] text-muted';
				duration.textContent = payload.duration_ms != null ? formatDuration(payload.duration_ms) : '';

				summary.append(titleRow, duration);

				const body = document.createElement('div');
				body.className = 'ml-4 mt-1 space-y-1 pb-2';

				const description = document.createElement('p');
				description.className = 'text-[11px] text-muted';
				description.textContent = getStepDescription(payload.stage);

				if (description.textContent) {
					body.append(description);
				}

				if (payload.rewritten_query && payload.stage === 'rewrite') {
					const line = document.createElement('p');
					line.className = 'text-[11px] text-muted-strong';
					line.textContent = `rewritten: ${payload.rewritten_query}`;
					body.append(line);
				}

				if (payload.model) {
					const line = document.createElement('p');
					line.className = 'text-[11px] text-muted-strong';
					line.textContent = `model: ${payload.model}`;
					body.append(line);
				}

				const counts = payload.counts;
				if (counts && typeof counts === 'object') {
					for (const [key, value] of Object.entries(counts)) {
						const line = document.createElement('p');
						line.className = 'text-[11px] text-muted-strong';
						line.textContent = `${key}: ${value}`;
						body.append(line);
					}
				}

				if (payload.debug) {
					const divider = document.createElement('hr');
					divider.className = 'my-2 border-border';
					body.append(divider);
					renderDebug(payload.debug, body);
				}

				if (payload.rag_query) {
					const label = document.createElement('p');
					label.className = 'mt-2 text-xs font-medium text-foreground';
					label.textContent = 'Full RAG query:';
					body.append(label);

					const pre = document.createElement('pre');
					pre.className = 'mt-1 max-h-48 overflow-auto border border-border bg-white p-2 text-[11px] text-muted-strong';
					pre.textContent = payload.rag_query;
					body.append(pre);
				}

				details.append(summary, body);
				item.append(details);
				return item;
			}

			function resetStatusLog() {
				statusList.replaceChildren();
				currentStatusItems = [];
			}

			function closeStream() {
				if (currentSource) {
					currentSource.close();
					currentSource = undefined;
				}
			}

			function renderSources(items) {
				sourcesList.replaceChildren();

				for (const [index, source] of items.entries()) {
					const li = document.createElement('li');
					li.className = 'border border-border bg-white p-3 text-sm text-muted-strong';

					const title = document.createElement('p');
					title.className = 'font-medium text-foreground';
					title.textContent = source.title ?? source.path ?? `Source ${index + 1}`;

					li.append(title);

					if (source.path) {
						const path = document.createElement('p');
						path.className = 'mt-1 text-muted-strong';
						path.textContent = source.path;
						li.append(path);
					}

					if (source.content_type) {
						const type = document.createElement('p');
						type.className = 'mt-1 text-muted';
						type.textContent = source.content_type;
						li.append(type);
					}

					if (source.relevance != null) {
						const relevance = document.createElement('p');
						relevance.className = 'mt-1 text-muted';
						relevance.textContent = `Relevance: ${String(source.relevance)}`;
						li.append(relevance);
					}

					if (source.content) {
						const content = document.createElement('p');
						content.className = 'mt-2 line-clamp-3 text-muted-strong';
						content.textContent = source.content;
						li.append(content);
					}

					sourcesList.append(li);
				}
			}

			form.addEventListener('submit', (event) => {
				event.preventDefault();

				const query = input.value.trim();

				if (!query) {
					setError('Enter a question first.');
					return;
				}

				sendQuery(query);
			});

			async function sendQuery(query) {
				if (!apiBaseUrl) {
					setError('Set PUBLIC_API_BASE_URL in the frontend env.');
					return;
				}

				closeStream();

				setError('');
				setLoading(true);
				response.hidden = true;
				markdownText = '';
				responseBody.innerHTML = '';
				sourcesList.replaceChildren();
				resetStatusLog();
				responseSection.hidden = true;
				sourcesSection.hidden = true;
				infoBar.hidden = true;
				statusLoading.hidden = true;
				statusToggle.open = true;
				templatesWrapper.hidden = true;
				const url = new URL(`${apiBaseUrl}/sales-assistant`);
				url.searchParams.set('query', query);

				currentSource = new EventSource(url.toString());

				currentSource.addEventListener('step', (event) => {
					const payload = JSON.parse(event.data);
					const item = renderStatusItem(payload);
					currentStatusItems.push(item);
					item.dataset.message = payload.message ?? 'Step';
					statusList.append(item);
					response.hidden = false;
					statusLoading.hidden = false;
				});

				currentSource.addEventListener('token', (event) => {
					response.hidden = false;
					infoBar.hidden = false;
					statusLoading.hidden = false;
					responseSection.hidden = false;
					markdownText += event.data ?? '';
					const normalized = markdownText.replace(/([.!?])([A-Z])/g, '$1 $2').replace(/  +/g, '\n\n');
				responseBody.innerHTML = window.marked.parse(normalized);
				});

				currentSource.addEventListener('sources', (event) => {
					const payload = JSON.parse(event.data);
					renderSources(Array.isArray(payload.results) ? payload.results : []);
					response.hidden = false;
					infoBar.hidden = false;
					statusLoading.hidden = false;
					sourcesSection.hidden = false;
				});

				currentSource.addEventListener('done', () => {
					setLoading(false);
					closeStream();
					statusLoading.hidden = true;
					statusToggle.open = false;
					templatesWrapper.hidden = false;
				});

				currentSource.addEventListener('error', () => {
					setLoading(false);
					setError('An error occurred in the backend. Visit uptime.noel.fyi to check if all systems are running.');
					closeStream();
				});
			}
		</script>
	</section>
</BaseLayout>
