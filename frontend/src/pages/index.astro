---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingPage from '../components/LandingPage.astro';
---

<BaseLayout title="Noel Schwabenland">
	<LandingPage />

	<div class="grid gap-8 my-8">
		<!-- Who I Am -->
		<section id="who-i-am" class="px-3 py-[var(--site-section-block)] sm:px-4 lg:px-6 border border-accent/20">
			<h2 class="mb-4 text-3xl font-semibold text-foreground">Who I Am</h2>
			<p class="text-muted-strong">Coming soon.</p>
		</section>

		<!-- My Work -->
		<section id="my-work" class="px-3 py-[var(--site-section-block)] sm:px-4 lg:px-6 border border-accent/20">
			<h2 class="mb-4 text-3xl font-semibold text-foreground">My Work</h2>
			<p class="text-muted-strong">Coming soon.</p>
		</section>

		<!-- My Background -->
		<section id="my-background" class="px-3 py-[var(--site-section-block)] sm:px-4 lg:px-6 border border-accent/20">
			<h2 class="mb-4 text-3xl font-semibold text-foreground">My Background</h2>
			<p class="text-muted-strong">Coming soon.</p>
		</section>

		<!-- My Tech Stack -->
		<section id="my-tech-stack" class="px-3 py-[var(--site-section-block)] sm:px-4 lg:px-6 border border-accent/20">
			<h2 class="mb-4 text-3xl font-semibold text-foreground">My Tech Stack</h2>
			<p class="text-muted-strong">Coming soon.</p>
		</section>

		<!-- Contact -->
		<section id="contact" class="px-3 py-[var(--site-section-block)] sm:px-4 lg:px-6 border border-accent/20">
			<h2 class="mb-4 text-3xl font-semibold text-foreground">Contact</h2>
			<p class="text-muted-strong">Coming soon.</p>
		</section>
	</div>
</BaseLayout>
