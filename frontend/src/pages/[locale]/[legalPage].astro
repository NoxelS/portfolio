---
import { setPublicPageCache } from '../../lib/cache';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { legalCopy, legalRevisionDate, operator } from '../../data/legal';
import { locales, type Locale } from '../../i18n';
import { legalPages, renderLegalContent, type LegalPage } from '../../lib/legal-content';

export const prerender = false;

const { locale, legalPage } = Astro.params;
if (!locales.includes(locale as Locale) || !legalPages.includes(legalPage as LegalPage)) {
	return new Response('Not found', { status: 404 });
}
const pageLocale = locale as Locale;
const page = legalPage as LegalPage;
setPublicPageCache(Astro.response.headers);
const labels = legalCopy[pageLocale];
const title = legalPage === 'legal-notice' ? labels.notice : legalPage === 'privacy' ? labels.privacy : labels.cookies;
const { html } = renderLegalContent(page, pageLocale);
const revisionLabel = new Intl.DateTimeFormat(locale === 'de' ? 'de-DE' : 'en-GB', {
	day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
}).format(new Date(legalRevisionDate));
---

<BaseLayout locale={pageLocale} title={`${title} | ${operator.name}`} description={labels.title} canonicalPath={`/${locale}/${legalPage}/`}>
	<div class="w-full min-w-0 px-4 py-8 text-black md:px-8 md:py-12">
		<header class="pb-8 md:pb-12">
			<div class="flex flex-wrap items-center justify-between gap-4 text-sm">
				<a href={`/${locale}/`}>{labels.home}</a>
				<nav aria-label={labels.language} class="flex gap-4">
					{locales.map(language => <a href={`/_locale/${language}?returnTo=/${language}/${legalPage}/`} lang={language} aria-current={language === locale ? 'page' : undefined} class:list={['uppercase', { 'font-bold': language === locale }]}>{language}</a>)}
				</nav>
			</div>
			<p class="mt-12 text-xs font-semibold uppercase tracking-widest">{labels.title}</p>
			<h1 class="mt-4 font-serif text-4xl leading-tight md:text-6xl">{title}</h1>
			<p class="mt-4 text-sm"><span>{labels.updated}: </span><time datetime={legalRevisionDate}>{revisionLabel}</time></p>
		</header>
		<div class="min-w-0 py-10">
			<div class="min-w-0">
				{legalPage === 'cookies' && <section id="cookie-settings" class="mb-8 py-5">
					<h2 class="font-serif text-xl">{labels.cookieTitle}</h2>
					<p class="mt-3 text-sm leading-relaxed">{labels.cookieDescription}</p>
					<a class="mt-4 inline-block text-sm font-semibold" href="#cookie-settings" data-cookie-settings>{labels.settings}</a>
				</section>}
				<article lang={locale} class="prose max-w-none text-black prose-headings:font-serif prose-headings:font-medium prose-headings:text-primary prose-p:leading-relaxed prose-a:text-primary prose-strong:text-black prose-code:break-all prose-code:text-black prose-blockquote:border-0 prose-blockquote:pl-0 prose-blockquote:text-black prose-th:text-black prose-td:align-top prose-thead:border-black/20 prose-tr:border-black/20 prose-li:marker:text-black [&_table]:block [&_table]:overflow-x-auto [&_table]:text-sm [&_th]:min-w-32 [&_th]:px-3 [&_td]:min-w-32 [&_td]:px-3 [&_td]:py-3 [&_td]:break-words" set:html={html} />
			</div>
		</div>
	</div>
</BaseLayout>
