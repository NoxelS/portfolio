COMPOSE_PROJECT_NAME=portfolio

FRONTEND_PORT=4321
BACKEND_PORT=8000

BUILD_VERSION=development
COMMIT_SHA=development
BUILT_AT=development
PUBLIC_BUILD_VERSION=development
PUBLIC_COMMIT_SHA=development
PUBLIC_BUILT_AT=development

PUBLIC_OPENPANEL_CLIENT_ID=
PUBLIC_OPENPANEL_API_URL=
PUBLIC_OPENPANEL_SCRIPT_URL=
PUBLIC_API_BASE_URL=

API_APP_NAME=Portfolio API
API_LOG_LEVEL=DEBUG
API_CORS_ORIGINS=["https://noel.fyi"]
API_LLM_BASE_URL=https://ai.noel.fyi
API_EMBEDDINGS_BASE_URL=https://ai.noel.fyi
API_RERANKING_BASE_URL=https://ai.noel.fyi
API_HTTP_TIMEOUT_SECONDS=300
# Replace this in your server .env with the Open WebUI API key.
API_OPENWEBUI_API_KEY=
API_EMBEDDING_MODEL=embedding-bge
API_EMBEDDINGS_PATH=/openai/embeddings
API_EMBEDDING_PREFIX=query: 
API_EMBEDDING_PASSAGE_PREFIX=passage: 
API_RERANKER_MODEL=reranking-bge
API_RERANKER_PATH=/openai/rerank
API_RERANKER_MINIMUM_RELEVANCE_PERCENT=0.1
API_LLM_MODEL=phi
API_CHAT_COMPLETIONS_PATH=/openai/chat/completions
API_MODELS_PATH=/openai/models
API_CHAT_MAX_TOKENS=256
API_CHAT_MODEL_CONTEXT_TOKENS=8192
API_CHAT_CONTEXT_RESERVED_TOKENS=768
API_REDIS_URL=redis://redis:6379
API_REDIS_INDEX_NAME=portfolio_content
API_ASSISTANT_TOP_N=8
API_RETRIEVAL_MAX_TOP_N=25
API_RETRIEVAL_MULTIPLIER=3
API_RETRIEVAL_MAX_K=75
API_BOOTSTRAP_CHUNK_SIZE=500
API_BOOTSTRAP_CHUNK_OVERLAP=100
API_NTFY_ENABLED=false
API_NTFY_TOPIC=
API_NTFY_HOST=https://ntfy.sh
API_NTFY_USER=
API_NTFY_PASSWORD=
API_NTFY_TITLE=Portfolio Sales Assistant
