---
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import SEO from '../components/SEO.astro';
import { hasOpenPanelConfig } from '../data/analytics';

interface Props {
	title?: string;
	description?: string;
	canonicalPath?: string;
}

const { title, description, canonicalPath } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<SEO title={title} description={description} canonicalPath={canonicalPath} />
	</head>
	<body>
		<slot />
		{hasOpenPanelConfig && <AnalyticsConsent />}
		{
			hasOpenPanelConfig && (
				<script>
					import '../scripts/analytics';
				</script>
			)
		}
	</body>
</html>
