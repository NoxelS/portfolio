---
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import SEO from '../components/SEO.astro';
import { getOpenPanelConfig } from '../data/analytics';

interface Props {
	title?: string;
	description?: string;
	canonicalPath?: string;
}

const { title, description, canonicalPath } = Astro.props;
const openPanelConfig = getOpenPanelConfig();
---

<!doctype html>
<html lang="en">
	<head>
		<SEO title={title} description={description} canonicalPath={canonicalPath} />
	</head>
	<body>
		<slot />
		{openPanelConfig && <AnalyticsConsent />}
		{
			openPanelConfig && (
				<script define:vars={{ openPanelConfig }}>
					window.__PORTFOLIO_ANALYTICS__ = openPanelConfig;
				</script>
			)
		}
		{
			openPanelConfig && (
				<script>
					import '../scripts/analytics';
				</script>
			)
		}
	</body>
</html>
