---
import { hasOpenPanelConfig } from '../data/analytics';
---

{
	hasOpenPanelConfig && (
		<div class="analytics-consent" data-analytics-consent-banner hidden>
			<p>
				I use privacy-conscious analytics to understand portfolio usage and technical performance. Analytics runs only if you accept.
			</p>
			<div class="analytics-consent__actions">
				<button type="button" data-analytics-consent-accept>
					Accept analytics
				</button>
				<button type="button" data-analytics-consent-reject>
					Reject analytics
				</button>
			</div>
		</div>
	)
}

<style>
	.analytics-consent {
		position: fixed;
		right: 1rem;
		bottom: 1rem;
		z-index: 1000;
		display: grid;
		gap: 0.75rem;
		max-width: min(28rem, calc(100vw - 2rem));
		padding: 1rem;
		color: #111827;
		background: #ffffff;
		border: 1px solid #d1d5db;
		border-radius: 0.75rem;
		box-shadow: 0 1rem 3rem rgb(15 23 42 / 18%);
	}

	.analytics-consent[hidden] {
		display: none;
	}

	.analytics-consent p {
		margin: 0;
		font: 0.9375rem/1.5 system-ui, sans-serif;
	}

	.analytics-consent__actions {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.5rem;
	}

	.analytics-consent button {
		padding: 0.625rem 0.75rem;
		font: 600 0.875rem/1 system-ui, sans-serif;
		color: #111827;
		background: #f9fafb;
		border: 1px solid #9ca3af;
		border-radius: 0.5rem;
		cursor: pointer;
	}

	.analytics-consent button:hover,
	.analytics-consent button:focus-visible {
		background: #f3f4f6;
		outline: 2px solid #2563eb;
		outline-offset: 2px;
	}
</style>
